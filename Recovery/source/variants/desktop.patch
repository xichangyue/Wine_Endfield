-    pagesize = (long)vm_kernel_page_size;
-
-    shm_addrs = calloc( 128, sizeof(shm_addrs[0]) );
-    shm_addrs_size = 128;
-
-    /* Bootstrap mach wineserver communication */
-
-    mach_msg2_trap = (mach_msg2_trap_ptr_t)dlsym( dlhandle, "mach_msg2_trap" );
