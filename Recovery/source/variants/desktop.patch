-    }
-    else if (!(buf->BufferType & SECBUFFER_UNMAPPED))
-    {
-        return SEC_E_OK;
-    }
-
-    if (!status)
-        status = lsa_CopyToClientBuffer( NULL, buf->cbBuffer, client_buf, buf->pvBuffer );
