-int __cdecl wmain( int argc, WCHAR *argv[] )
-{
-    static const SERVICE_TABLE_ENTRYW service_table[] =
-    {
-        { samssW, ServiceMain },
-        { NULL, NULL }
-    };
-
-    StartServiceCtrlDispatcherW( service_table );
-    return 0;
-}
