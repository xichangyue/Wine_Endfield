+    TRACE( "%Ix, %lu, %p\n", context, attribute, buffer );
+
+    if (!context) return SEC_E_INVALID_HANDLE;
+
+    ctxt = (struct sec_handle *)context;
+    if (ctxt->krb)
+    {
+        ret = ctxt->krb->SpQueryContextAttributes( ctxt->handle_krb, attribute, buffer );
+    }
+    else if (ctxt->ntlm)
+    {
