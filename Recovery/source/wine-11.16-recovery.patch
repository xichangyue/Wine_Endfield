+ */
+DEFINE_FASTCALL1_WRAPPER(KeTryToAcquireGuardedMutex)
+BOOLEAN FASTCALL KeTryToAcquireGuardedMutex(PKGUARDED_MUTEX mutex)
+{
+    struct _KTHREAD *thread = KeGetCurrentThread();
+
+    /* Resolving a cold KTHREAD can use Wine metadata/server facilities. This
+     * attempt itself never waits for the mutex or registers an event waiter. */
+    thread->guarded_region++;
+    if (InterlockedCompareExchange( &mutex->Count, 0, FM_LOCK_BIT ) != FM_LOCK_BIT)
+    {
