+static NTSTATUS NTAPI nego_SpGetInfo( SecPkgInfoW *info )
+{
+    const SecPkgInfoW infoW = {CAPS, 1, RPC_C_AUTHN_GSS_NEGOTIATE, NEGO_MAX_TOKEN,
+                               nego_name_W, negotiate_comment_W};
