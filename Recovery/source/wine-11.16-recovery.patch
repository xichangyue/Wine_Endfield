+NTSTATUS WINAPI SeQueryInformationToken( PACCESS_TOKEN token, TOKEN_INFORMATION_CLASS info_class, void **info )
+{
+    HANDLE handle;
+    ULONG length = 0;
+    NTSTATUS status;
+    if (!info) return STATUS_INVALID_PARAMETER;
+    *info = NULL;
+    if ((status = ObOpenObjectByPointer( token, 0, NULL, TOKEN_QUERY,
+                                        SeTokenObjectType, KernelMode, &handle ))) return status;
+    status = NtQueryInformationToken( handle, info_class, NULL, 0, &length );
+    if (status == STATUS_BUFFER_TOO_SMALL && length)
+    {
+        if (!(*info = ExAllocatePool( PagedPool, length ))) status = STATUS_NO_MEMORY;
+        else if ((status = NtQueryInformationToken( handle, info_class, *info, length, &length )))
+        {
+            ExFreePool( *info );
+            *info = NULL;
+        }
+    }
+    NtClose( handle );
+    return status;
+}
