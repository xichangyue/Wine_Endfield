+        TRACE( "MDL locked %p source %p pin %p size %Iu\n", mdl, address, lock->pin, remaining );
+        goto done;
+failed:
+        free( lock );
+        goto done;
+    }
+done:
+    LeaveCriticalSection( &mdl_section_cs );
+    return status;
+}
+
+static void *map_mdl_section( struct mdl_section_lock *lock )
+{
+    SIZE_T size = lock->size;
+    NTSTATUS status;
+
+    if (!lock->mapping)
+    {
+        status = NtMapViewOfSection( lock->view->section, GetCurrentProcess(), &lock->mapping, 0, 0,
+                                    &lock->offset, &size, ViewUnmap, 0, lock->protect );
+        if (status)
+        {
+            TRACE( "MDL map %p failed %#lx\n", lock->mdl, status );
+            return NULL;
+        }
+    }
+    lock->mdl->MappedSystemVa = (char *)lock->mapping + lock->delta;
+    lock->mdl->MdlFlags |= MDL_MAPPED_TO_SYSTEM_VA;
+    TRACE( "MDL alias %p -> %p\n", lock->mdl, lock->mdl->MappedSystemVa );
+    return lock->mdl->MappedSystemVa;
+}
