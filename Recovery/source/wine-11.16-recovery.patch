+NTSTATUS WINAPI KeGetProcessorNumberFromIndex( ULONG index, PROCESSOR_NUMBER *number )
+{
+    /* Callable at any IRQL: no allocation, locks, waits or scheduler changes.
+     * The output pointer is required. Invalid caller memory is not suppressed. */
+    if (index >= processor_index_count) return STATUS_INVALID_PARAMETER;
+    *number = processor_index_table[index];
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           KeGetProcessorIndexFromNumber   (NTOSKRNL.EXE.@)
+ */
+ULONG WINAPI KeGetProcessorIndexFromNumber( const PROCESSOR_NUMBER *number )
+{
+    const USHORT group = number->Group;
+    const UCHAR processor = number->Number;
+    ULONG index;
+
+    if (number->Reserved) return ~0u; /* INVALID_PROCESSOR_INDEX */
+
+    /* Use the same immutable topology as the inverse mapping. No allocation,
+     * locks or affinity changes are needed, including for sparse group masks.
+     * The input pointer is required. */
+    for (index = 0; index < processor_index_count; index++)
+        if (processor_index_table[index].Group == group &&
+            processor_index_table[index].Number == processor) return index;
+
+    return ~0u; /* INVALID_PROCESSOR_INDEX */
+}
