+            status = STATUS_NO_MEMORY;
+            goto done;
+        }
+        /* Section offsets use allocation granularity, while the locked range
+         * is just the MDL's page span within that view. */
+        start = relative & ~(SIZE_T)0xffff;
+        lock->delta = relative - start;
+        lock->size = (lock->delta + remaining + PAGE_SIZE - 1) & ~(SIZE_T)(PAGE_SIZE - 1);
