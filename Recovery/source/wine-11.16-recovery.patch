+#include "ntoskrnl_private.h"
+#endif
+#include "deferred.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ntoskrnl);
+
+static INIT_ONCE init_once = INIT_ONCE_STATIC_INIT;
+static HANDLE wake_event, drained_event, worker_handle;
+static struct list pending = LIST_INIT(pending);
+DECLARE_CRITICAL_SECTION(deferred_cs);
+static struct deferred_delete_stats counters;
+#ifdef DEFERRED_NATIVE_TEST
+static BOOL test_stop;
+#endif
+
+static DWORD WINAPI deferred_worker(void *unused)
+{
+    struct deferred_delete_entry *entry;
+    BOOL complete;
+    DWORD wait;
+    (void)unused;
+
+    for (;;)
+    {
+        EnterCriticalSection(&deferred_cs);
+        if (list_empty(&pending))
+        {
+#ifdef DEFERRED_NATIVE_TEST
+            if (test_stop)
+            {
+                LeaveCriticalSection(&deferred_cs);
+                return 0;
+            }
+#endif
+            if (!ResetEvent(wake_event)) counters.wake_failures++;
+            LeaveCriticalSection(&deferred_cs);
+            /* A timeout also guarantees a queue check if a wake failed. */
+            wait = WaitForSingleObject(wake_event, 100);
+            if (wait == WAIT_FAILED)
+            {
+                EnterCriticalSection(&deferred_cs);
+                counters.wake_failures++;
+                LeaveCriticalSection(&deferred_cs);
+                Sleep(100);
+            }
+            continue;
+        }
+
+        entry = LIST_ENTRY(list_head(&pending), struct deferred_delete_entry, entry);
+        list_remove(&entry->entry);
+        list_init(&entry->entry);
+        counters.queued--;
+        counters.inflight++;
+        LeaveCriticalSection(&deferred_cs);
+
+        /* A successful consume may free entry. Never access it afterwards. */
+        complete = entry->consume(entry);
+        if (!complete) Sleep(10);
+
+        EnterCriticalSection(&deferred_cs);
+        counters.inflight--;
+        if (complete) counters.completed++;
+        else
+        {
+            /* Failure retains the object's actual queue reference. */
+            list_add_tail(&pending, &entry->entry);
+            counters.queued++;
+            counters.retries++;
+        }
+        if (!counters.inflight && list_empty(&pending))
+            if (!SetEvent(drained_event)) counters.wake_failures++;
+        LeaveCriticalSection(&deferred_cs);
+    }
+}
+
+static BOOL CALLBACK initialize_executor(INIT_ONCE *once, void *parameter, void **context)
+{
+    HANDLE wake, drained, worker;
+    HMODULE module;
+    (void)once; (void)parameter; (void)context;
+
+    if (!(wake = CreateEventW(NULL, TRUE, FALSE, NULL))) return FALSE;
+    if (!(drained = CreateEventW(NULL, TRUE, TRUE, NULL)))
+    {
+        CloseHandle(wake);
+        return FALSE;
+    }
+    /* The host already treats NtOS as resident. Make that lifetime explicit
+     * for direct callers too: no active worker can execute unloaded code.
+     * PIN is deliberately irreversible until process exit. No DllMain join. */
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                           (const WCHAR *)deferred_delete_ensure, &module))
+    {
+        CloseHandle(drained);
+        CloseHandle(wake);
+        return FALSE;
+    }
+
+    /* All inputs are initialized before CreateThread, which can run its entry
+     * before returning. No further worker startup allocation/handshake. */
+    wake_event = wake;
+    drained_event = drained;
+    if (!(worker = CreateThread(NULL, 0, deferred_worker, NULL, 0, NULL)))
+    {
+        wake_event = drained_event = NULL;
+        CloseHandle(drained);
+        CloseHandle(wake);
+        return FALSE;
+    }
+    worker_handle = worker;
+    TRACE("DEFERRED-DELETE executor_ready worker=%p resident_module=%p process_lifetime=1\n", worker_handle, module);
+    return TRUE;
+}
+
+BOOL deferred_delete_ensure(void)
+{
+    return InitOnceExecuteOnce(&init_once, initialize_executor, NULL, NULL);
+}
+
+void deferred_delete_enqueue(struct deferred_delete_entry *entry)
+{
+    /* alloc_kernel_object ensures the executor before publishing the body.
+     * No allocation or work-item submission is needed at final release. */
+    EnterCriticalSection(&deferred_cs);
+    list_add_tail(&pending, &entry->entry);
+    counters.queued++;
+    counters.accepted++;
+    if (!ResetEvent(drained_event)) counters.wake_failures++;
+    if (!SetEvent(wake_event)) counters.wake_failures++;
+    LeaveCriticalSection(&deferred_cs);
+}
+
+BOOL deferred_delete_idle(struct deferred_delete_stats *stats)
+{
+    BOOL idle;
+    EnterCriticalSection(&deferred_cs);
+    if (stats) *stats = counters;
+    idle = !counters.queued && !counters.inflight;
+    LeaveCriticalSection(&deferred_cs);
+    return idle;
+}
+
+HANDLE deferred_delete_drain_event(void)
+{
+    return drained_event;
+}
+
+#ifdef DEFERRED_NATIVE_TEST
+/* Native fault fixtures only; the production executor is process-lifetime. */
+void deferred_delete_test_stop(void)
+{
+    EnterCriticalSection(&deferred_cs);
+    test_stop = TRUE;
+    LeaveCriticalSection(&deferred_cs);
+    SetEvent(wake_event);
+    WaitForSingleObject(worker_handle, INFINITE);
+    CloseHandle(worker_handle);
+    CloseHandle(wake_event);
+    CloseHandle(drained_event);
+}
+#endif
