+/* A locked shared-section MDL owns a pinned backing view independently of
+ * its optional system mapping and of the caller's original section view. */
+struct mdl_section_view
+{
+    struct list entry;
+    void *base;
+    SIZE_T size;
+    LARGE_INTEGER offset;
+    HANDLE section;
+    unsigned int refs;
+};
+
+struct mdl_section_lock
+{
+    struct list entry;
+    MDL *mdl;
+    struct mdl_section_view *view;
+    void *pin, *locked_base, *mapping;
+    SIZE_T size, locked_size, delta;
+    LARGE_INTEGER offset;
+    ULONG protect;
+};
+
+static struct list mdl_section_views = LIST_INIT( mdl_section_views );
+static struct list mdl_section_locks = LIST_INIT( mdl_section_locks );
+DECLARE_CRITICAL_SECTION(mdl_section_cs);
+
+static void release_mdl_section_view( struct mdl_section_view *view )
+{
+    if (--view->refs) return;
+    NtClose( view->section );
+    free( view );
+}
+
+static struct mdl_section_lock *find_mdl_section_lock( MDL *mdl )
+{
+    struct mdl_section_lock *lock;
+    LIST_FOR_EACH_ENTRY( lock, &mdl_section_locks, struct mdl_section_lock, entry )
+        if (lock->mdl == mdl) return lock;
+    return NULL;
+}
+
+static void unmap_mdl_section_lock( struct mdl_section_lock *lock )
+{
+    if (lock->mapping) NtUnmapViewOfSection( GetCurrentProcess(), lock->mapping );
+    lock->mapping = NULL;
+    lock->mdl->MappedSystemVa = NULL;
+    lock->mdl->MdlFlags &= ~MDL_MAPPED_TO_SYSTEM_VA;
+}
+
+static void release_mdl_section_lock( MDL *mdl )
+{
+    struct mdl_section_lock *lock;
+
+    EnterCriticalSection( &mdl_section_cs );
+    if ((lock = find_mdl_section_lock( mdl )))
+    {
+        unmap_mdl_section_lock( lock );
+        NtUnlockVirtualMemory( GetCurrentProcess(), &lock->locked_base, &lock->locked_size, 1 );
+        NtUnmapViewOfSection( GetCurrentProcess(), lock->pin );
+        list_remove( &lock->entry );
+        release_mdl_section_view( lock->view );
+        free( lock );
+        mdl->MdlFlags &= ~MDL_PAGES_LOCKED;
+    }
+    LeaveCriticalSection( &mdl_section_cs );
+}
+
+NTSTATUS WINAPI ZwMapViewOfSection( HANDLE section, HANDLE process, void **base, ULONG zero_bits,
+                                   SIZE_T commit, const LARGE_INTEGER *offset, SIZE_T *size,
+                                   SECTION_INHERIT inherit, ULONG alloc, ULONG protect )
+{
+    struct mdl_section_view *view;
+    MEMORY_BASIC_INFORMATION info;
+    NTSTATUS status;
+
+    /* Other process mappings and non-shared protections retain their existing path. */
+    if (process != GetCurrentProcess() || (protect != PAGE_READONLY && protect != PAGE_READWRITE))
+        return NtMapViewOfSection( section, process, base, zero_bits, commit, offset, size, inherit, alloc, protect );
+
+    EnterCriticalSection( &mdl_section_cs );
+    status = NtMapViewOfSection( section, process, base, zero_bits, commit, offset, size, inherit, alloc, protect );
+    if (status) goto done;
+    if (!VirtualQuery( *base, &info, sizeof(info) ) || info.Type != MEM_MAPPED) goto done;
+
+    if (!(view = calloc( 1, sizeof(*view) ))) status = STATUS_NO_MEMORY;
+    else
+    {
+        status = NtDuplicateObject( GetCurrentProcess(), section, GetCurrentProcess(),
+                                    &view->section, 0, 0, DUPLICATE_SAME_ACCESS );
+        if (!status)
+        {
+            view->base = *base;
+            view->size = *size;
+            if (offset) view->offset = *offset;
+            view->refs = 1;
+            list_add_tail( &mdl_section_views, &view->entry );
+            TRACE( "MDL section view %p size %Iu section %p\n", view->base, view->size, view->section );
+            goto done;
+        }
+        free( view );
+    }
+    NtUnmapViewOfSection( process, *base );
+done:
+    LeaveCriticalSection( &mdl_section_cs );
+    return status;
+}
+
+NTSTATUS WINAPI ZwUnmapViewOfSection( HANDLE process, void *base )
+{
+    struct mdl_section_view *view;
+    NTSTATUS status;
+
+    if (process != GetCurrentProcess()) return NtUnmapViewOfSection( process, base );
+    EnterCriticalSection( &mdl_section_cs );
+    status = NtUnmapViewOfSection( process, base );
+    if (!status)
+    {
+        LIST_FOR_EACH_ENTRY( view, &mdl_section_views, struct mdl_section_view, entry )
+        {
+            if ((ULONG_PTR)base < (ULONG_PTR)view->base || (ULONG_PTR)base - (ULONG_PTR)view->base >= view->size)
+                continue;
+            list_remove( &view->entry );
+            release_mdl_section_view( view );
+            break;
+        }
+    }
+    LeaveCriticalSection( &mdl_section_cs );
+    return status;
+}
