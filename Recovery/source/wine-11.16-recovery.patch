+PHYSICAL_MEMORY_RANGE *WINAPI MmGetPhysicalMemoryRanges(void)
+{
+    SYSTEM_BASIC_INFORMATION info;
+    PHYSICAL_MEMORY_RANGE *ranges;
+    /* FineWine/dw-proton's reported-memory model, with an allocated result
+     * and a terminating zero entry as required by the Windows API. */
+    if (NtQuerySystemInformation( SystemBasicInformation, &info, sizeof(info), NULL )) return NULL;
+    if (!(ranges = ExAllocatePool( NonPagedPool, 2 * sizeof(*ranges) ))) return NULL;
+    memset( ranges, 0, 2 * sizeof(*ranges) );
+    ranges[0].BaseAddress.QuadPart = (ULONGLONG)info.MmLowestPhysicalPage * info.PageSize;
+    ranges[0].NumberOfBytes.QuadPart = (ULONGLONG)info.MmNumberOfPhysicalPages * info.PageSize;
+    return ranges;
+}
