+/* DXMT 0.80 consumes the Wine 10 window-data prefix.  Wine 11 removed
+ * cocoa_view, so exposing get_win_data directly would give it rectangle
+ * bytes as an Objective-C pointer. Keep this ABI adapter separate from
+ * Wine's private data. Wine 11 client surfaces also own the view lifetime. */
+struct dxmt_win_data
+{
+    HWND hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view cocoa_view;
+    macdrv_view client_cocoa_view;
+    struct client_surface *surface;
+};
+
+struct dxmt_metal_view
+{
+    macdrv_metal_view view;
+    struct client_surface *surface;
+};
+
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct dxmt_win_data *bridge = calloc(1, sizeof(*bridge));
+    struct macdrv_win_data *data;
+    if (!bridge) abort();
+    data = get_win_data(hwnd);
+    if (data)
+    {
+        bridge->hwnd = data->hwnd;
+        bridge->cocoa_window = data->cocoa_window;
+        release_win_data(data);
+        bridge->surface = macdrv_CreateClientSurface(hwnd, 0);
+        /* This slot is private to the create_view adapter below. */
+        bridge->client_cocoa_view = (macdrv_view)bridge;
+    }
+    return bridge;
+}
+
+static void dxmt_release_win_data(struct dxmt_win_data *bridge)
+{
+    if (bridge->surface) client_surface_release(bridge->surface);
+    free(bridge);
+}
+
+static void dxmt_before_drawable(void *context)
+{
+    client_surface_present(context);
+}
+
+static macdrv_metal_view dxmt_create_metal_view(macdrv_view view, macdrv_metal_device device)
+{
+    struct dxmt_win_data *bridge = (struct dxmt_win_data *)view;
+    struct dxmt_metal_view *metal;
+    if (!bridge || !bridge->surface || !device) return NULL;
+    if (!(metal = calloc(1, sizeof(*metal)))) return NULL;
+    metal->view = macdrv_view_create_metal_view(impl_from_client_surface(bridge->surface)->cocoa_view, device);
+    if (!metal->view) { free(metal); return NULL; }
+    metal->surface = bridge->surface;
+    bridge->surface = NULL;
+    macdrv_metal_view_set_present_callback(metal->view, dxmt_before_drawable, metal->surface);
+    client_surface_present(metal->surface);
+    return (macdrv_metal_view)metal;
+}
+
+static macdrv_metal_layer dxmt_get_metal_layer(macdrv_metal_view view)
+{
+    struct dxmt_metal_view *metal = (struct dxmt_metal_view *)view;
+    return macdrv_view_get_metal_layer(metal->view);
+}
+
+static void dxmt_release_metal_view(macdrv_metal_view view)
+{
+    struct dxmt_metal_view *metal = (struct dxmt_metal_view *)view;
+    macdrv_metal_view_set_present_callback(metal->view, NULL, NULL);
+    macdrv_view_release_metal_view(metal->view);
+    client_surface_release(metal->surface);
+    free(metal);
+}
+
+/* Layout is defined by DXMT's winemetal_unix.c at tag v0.80. Unused entries
+ * remain reserved; only the five entries consumed by DXMT are exported. */
+__attribute__((visibility("default"))) const struct
+{
+    void *init_display_devices;
+    struct dxmt_win_data *(*get_data)(HWND);
+    void (*release_data)(struct dxmt_win_data *);
+    void *get_cocoa_window;
+    void *create_device;
+    void *release_device;
+    macdrv_metal_view (*create_view)(macdrv_view, macdrv_metal_device);
+    macdrv_metal_layer (*get_layer)(macdrv_metal_view);
+    void (*release_view)(macdrv_metal_view);
+    void *main_thread;
+} macdrv_functions =
+{
+    NULL, dxmt_get_win_data, dxmt_release_win_data, NULL, NULL, NULL,
+    dxmt_create_metal_view, dxmt_get_metal_layer,
+    dxmt_release_metal_view, NULL
+};
