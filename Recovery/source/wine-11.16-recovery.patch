+/* Use the same Count/event handoff as fast mutexes, but keep ownership and
+ * guarded-region accounting local to guarded mutexes. A failed backend wait
+ * must not return to the caller as a successful acquisition. */
+static NTSTATUS acquire_guarded_mutex( KGUARDED_MUTEX *mutex, PKTHREAD thread )
+{
+    NTSTATUS status;
+
+    if (InterlockedDecrement( &mutex->Count ) < 0)
+    {
+        InterlockedIncrement( (LONG *)&mutex->Contention );
+        if ((status = KeWaitForSingleObject( &mutex->Event, Executive, KernelMode, FALSE, NULL )))
+            return status;
+    }
+    mutex->Owner = thread;
+    return STATUS_SUCCESS;
+}
+
+static void release_guarded_mutex( KGUARDED_MUTEX *mutex )
+{
+    mutex->Owner = NULL;
+    if (InterlockedIncrement( &mutex->Count ) < 1)
+        KeSetEvent( &mutex->Event, IO_NO_INCREMENT, FALSE );
+}
