+@interface WineDXMTMetalLayer : CAMetalLayer
+{
+@public
+    void (*before_drawable)(void *);
+    void *present_context;
+    unsigned long drawable_count;
+    double stats_start, stats_callback, stats_acquire, stats_previous, stats_max_interval;
+    unsigned stats_count;
+}
+@end
+
+@implementation WineDXMTMetalLayer
+- (id<CAMetalDrawable>)nextDrawable
+{
+    BOOL measure = getenv("ENDFIELD_FRAME_STATS") != NULL;
+    double start = measure ? CACurrentMediaTime() : 0;
+    if (before_drawable) before_drawable(present_context);
+    double after_callback = measure ? CACurrentMediaTime() : 0;
+    id<CAMetalDrawable> drawable = [super nextDrawable];
+    if (measure)
+    {
+        double end = CACurrentMediaTime();
+        if (!stats_count) stats_start = start;
+        if (stats_previous) stats_max_interval = MAX(stats_max_interval, start - stats_previous);
+        stats_previous = start;
+        stats_callback += after_callback - start;
+        stats_acquire += end - after_callback;
+        if (++stats_count == 120)
+        {
+            fprintf(stderr, "ENDFIELD-FRAMES layer=%p size=%.0fx%.0f calls_per_second=%.1f callback_ms=%.3f acquire_ms=%.3f max_interval_ms=%.1f\n",
+                    self, self.drawableSize.width, self.drawableSize.height, 120.0 / (end - stats_start),
+                    stats_callback * 1000 / 120, stats_acquire * 1000 / 120, stats_max_interval * 1000);
+            stats_count = 0;
+            stats_callback = stats_acquire = stats_max_interval = 0;
+        }
+    }
+    ++drawable_count;
+    if (getenv("ENDFIELD_METAL_DIAGNOSTICS") &&
+        (drawable_count <= 3 || drawable_count == 120))
+        fprintf(stderr, "ENDFIELD-METAL layer=%p drawable=%lu valid=%d size=%.0fx%.0f hidden=%d\n",
+                self, drawable_count, drawable != nil, self.drawableSize.width,
+                self.drawableSize.height, self.hidden);
+    return drawable;
+}
+@end
