+/* Registration is independent of dump creation. Wine currently has no kernel
+ * crash-dump writer, so these records are not dispatched by KeBugCheckEx.
+ * In particular, do not invent SecondaryDumpData buffers on process exit. */
+static LIST_ENTRY bugcheck_reason_callbacks = { &bugcheck_reason_callbacks, &bugcheck_reason_callbacks };
+DECLARE_CRITICAL_SECTION(bugcheck_reason_cs);
+
+BOOLEAN WINAPI KeRegisterBugCheckReasonCallback( KBUGCHECK_REASON_CALLBACK_RECORD *record,
+        PKBUGCHECK_REASON_CALLBACK_ROUTINE callback, KBUGCHECK_CALLBACK_REASON reason, UCHAR *component )
+{
+    LIST_ENTRY *entry;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "%p %p %u %s\n", record, callback, reason, debugstr_a((char *)component) );
+    if (!record || !callback || reason < KbCallbackSecondaryDumpData || reason > KbCallbackTriageDumpData)
+    {
+        TRACE( "record %p reason %u -> 0\n", record, reason );
+        return FALSE;
+    }
+
+    EnterCriticalSection( &bugcheck_reason_cs );
+    for (entry = bugcheck_reason_callbacks.Flink; entry != &bugcheck_reason_callbacks; entry = entry->Flink)
+        if (entry == &record->Entry) goto done;
+    if (record->State != BufferEmpty) goto done;
+
+    record->CallbackRoutine = callback;
+    record->Component = component;
+    record->Checksum = 0; /* No dump serialization/checksum consumer in Wine. */
+    record->Reason = reason;
+    InsertTailList( &bugcheck_reason_callbacks, &record->Entry );
+    record->State = BufferInserted;
+    ret = TRUE;
+done:
+    LeaveCriticalSection( &bugcheck_reason_cs );
+    TRACE( "record %p reason %u -> %u\n", record, reason, ret );
+    return ret;
+}
+
+BOOLEAN WINAPI KeDeregisterBugCheckReasonCallback( KBUGCHECK_REASON_CALLBACK_RECORD *record )
+{
+    LIST_ENTRY *entry;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "%p\n", record );
+    if (!record) return FALSE;
+
+    EnterCriticalSection( &bugcheck_reason_cs );
+    for (entry = bugcheck_reason_callbacks.Flink; entry != &bugcheck_reason_callbacks; entry = entry->Flink)
+        if (entry == &record->Entry)
+        {
+            RemoveEntryList( entry );
+            InitializeListHead( entry );
+            record->State = BufferEmpty;
+            ret = TRUE;
+            break;
+        }
+    LeaveCriticalSection( &bugcheck_reason_cs );
+    TRACE( "record %p -> %u\n", record, ret );
+    return ret;
+}
