+wchar_t* CDECL midl_wcsdup( const wchar_t* str )
+{
+    wchar_t* ret = NULL;
+    if (str)
+    {
+        size_t size = (wcslen(str) + 1) * sizeof(wchar_t);
+        ret = MIDL_user_allocate( size );
+        if (ret) memcpy( ret, str, size );
+    }
+    return ret;
+}
