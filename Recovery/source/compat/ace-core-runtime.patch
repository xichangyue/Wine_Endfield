diff --git a/programs/wineboot/wineboot.c b/programs/wineboot/wineboot.c
--- a/programs/wineboot/wineboot.c
+++ b/programs/wineboot/wineboot.c
@@ -1443,6 +1443,62 @@ static int ProcessWindowsFileProtection(void)
     return 1;
 }
 
+static BOOL wait_for_service_running( SC_HANDLE service )
+{
+    SERVICE_STATUS_PROCESS status;
+    ULONGLONG deadline = GetTickCount64() + 10000;
+    DWORD needed;
+
+    for (;;)
+    {
+        if (!QueryServiceStatusEx( service, SC_STATUS_PROCESS_INFO, (BYTE *)&status,
+                                   sizeof(status), &needed ))
+        {
+            WINE_ERR( "Couldn't query SamSs: error %lu\n", GetLastError() );
+            return FALSE;
+        }
+        if (status.dwCurrentState == SERVICE_RUNNING) return TRUE;
+        if (status.dwCurrentState == SERVICE_STOPPED)
+        {
+            WINE_ERR( "SamSs stopped during startup: service error %lu\n",
+                      status.dwWin32ExitCode );
+            return FALSE;
+        }
+        if (GetTickCount64() >= deadline)
+        {
+            WINE_ERR( "Timed out waiting for SamSs to start\n" );
+            return FALSE;
+        }
+        Sleep( 100 );
+    }
+}
+
+static void start_samss_service(void)
+{
+    SC_HANDLE manager, service;
+    DWORD error;
+
+    if (!(manager = OpenSCManagerW( NULL, NULL, SC_MANAGER_CONNECT )))
+    {
+        WINE_ERR( "Couldn't open the service manager for SamSs: error %lu\n", GetLastError() );
+        return;
+    }
+    if (!(service = OpenServiceW( manager, L"SamSs", SERVICE_START | SERVICE_QUERY_STATUS )))
+    {
+        WINE_ERR( "Couldn't open SamSs: error %lu\n", GetLastError() );
+        CloseServiceHandle( manager );
+        return;
+    }
+
+    if (!StartServiceW( service, 0, NULL ) && (error = GetLastError()) != ERROR_SERVICE_ALREADY_RUNNING)
+        WINE_ERR( "Couldn't start SamSs: error %lu\n", error );
+    else
+        wait_for_service_running( service );
+
+    CloseServiceHandle( service );
+    CloseServiceHandle( manager );
+}
+
 static BOOL create_native_process( const WCHAR *app, WCHAR *cmdline, BOOL inherit, DWORD flags,
                                    const WCHAR *curdir, PROCESS_INFORMATION *info )
 {
@@ -1936,6 +1992,7 @@ int __cdecl main( int argc, char *argv[] )
