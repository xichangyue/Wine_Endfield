From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Endfield Mac Lab <1725548630@qq.com>
Date: Thu, 12 Nov 2026 00:00:00 +0800
Subject: [PATCH] ntoskrnl, wineboot: complete ACE-CORE startup compatibility

Combine the remaining public FineWine/dwproton ACE-CORE fixes needed by the
published Endfield runtime: three kernel imports, MmCopyMemory, and deterministic
SamSs registration/startup.  The runtime already ships Wine 11.17's full LSA/RPC
implementation, so start it through the service manager instead of replacing it
with the older compatibility stub.

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -3735,6 +3735,19 @@ ULONG WINAPI KeQueryTimeIncrement(void)
 {
     return 10000;
 }
+
+/***********************************************************************
+ *           KeIpiGenericCall   (NTOSKRNL.EXE.@)
+ */
+typedef ULONG_PTR (WINAPI *KIPI_BROADCAST_WORKER)(ULONG_PTR);
+
+ULONG_PTR WINAPI KeIpiGenericCall(KIPI_BROADCAST_WORKER function, ULONG_PTR context)
+{
+    /* Wine cannot issue kernel IPIs. Run the worker synchronously on the
+     * calling processor, matching the FineWine ACE-CORE compatibility path. */
+    FIXME("(%p, %#Ix): semi-stub, running on the calling processor only.\n", function, context);
+    return function(context);
+}
 
 
 /***********************************************************************
@@ -3803,6 +3816,37 @@ void WINAPI KeRevertToUserAffinityThreadEx(KAFFINITY affinity)
     NtSetInformationThread(GetCurrentThread(), ThreadGroupInformation, &new, sizeof(new));
     thread->user_affinity = affinity;
 }
+
+/***********************************************************************
+ *           KeSetSystemGroupAffinityThread   (NTOSKRNL.EXE.@)
+ */
+void WINAPI KeSetSystemGroupAffinityThread(PGROUP_AFFINITY affinity, PGROUP_AFFINITY previous)
+{
+    GROUP_AFFINITY old;
+
+    TRACE("affinity %p, previous %p.\n", affinity, previous);
+
+    memset(&old, 0, sizeof(old));
+    NtQueryInformationThread(GetCurrentThread(), ThreadGroupInformation,
+                             &old, sizeof(old), NULL);
+    if (previous) *previous = old;
+
+    if (affinity)
+        NtSetInformationThread(GetCurrentThread(), ThreadGroupInformation,
+                               affinity, sizeof(*affinity));
+}
+
+/***********************************************************************
+ *           KeRevertToUserGroupAffinityThread   (NTOSKRNL.EXE.@)
+ */
+void WINAPI KeRevertToUserGroupAffinityThread(PGROUP_AFFINITY previous)
+{
+    TRACE("previous %p.\n", previous);
+
+    if (previous)
+        NtSetInformationThread(GetCurrentThread(), ThreadGroupInformation,
+                               previous, sizeof(*previous));
+}
 
 /***********************************************************************
  *           IoRegisterFileSystem   (NTOSKRNL.EXE.@)
@@ -4751,6 +4795,18 @@ PVOID WINAPI PsGetProcessWow64Process(PEPROCESS process)
     return NULL;
 }
 
+/*********************************************************************
+ *           MmCopyMemory    (NTOSKRNL.@)
+ */
+NTSTATUS WINAPI MmCopyMemory(void *target, MM_COPY_ADDRESS source, SIZE_T size, ULONG flags, SIZE_T *copied)
+{
+    FIXME("target %p, source %s, size %Iu, flags %#lx, copied %p stub.\n",
+            target, wine_dbgstr_longlong(source.PhysicalAddress.QuadPart), size, flags, copied);
+
+    *copied = 0;
+    return STATUS_NOT_IMPLEMENTED;
+}
+
 /*********************************************************************
  *           MmCopyVirtualMemory    (NTOSKRNL.@)
  */
