+		result.dynamicIndex = static_cast<int32_t>(index);
+		result.dynamicOffset = offsets[index];
+	}
+	if (result.descriptorOffset > UINT64_MAX - result.dynamicOffset) {
+		result.status = Status::InvalidBounds;
