+} // namespace detail
+
+inline bool enabled() {
+    static const bool value = detail::initialize();
+    return value;
+}
+
+inline void record(const Record& value) {
+    // Deliberately does not call enabled(): record must never initialize, allocate,
+    // start a thread, perform file I/O, spin, or wait for a producer/drainer.
+    detail::State* state = detail::published().load(std::memory_order_acquire);
+    if (state) { state->put(value); }
+}
+
+// No clock, thread query, initialization, or queue access until begin() is called.
+// Call sites guard begin() with enabled(), including argument evaluation. The
+// scope stores only scalar values: submission completion may destroy its owner.
+class CpuSpan {
+public:
+    CpuSpan() : _id(0) {}
+    CpuSpan(const CpuSpan&) = delete;
+    CpuSpan& operator=(const CpuSpan&) = delete;
+    ~CpuSpan() { end(INT64_MIN); } // Abnormal/no explicit return: result unknown.
+
+    bool active() const { return _id != 0; }
+
+    void begin(Operation operation, uint64_t stream, uint64_t arg0 = 0, uint64_t arg1 = 0,
+               uint64_t auxiliary = UINT64_MAX) {
+        if (!enabled() || _id) { return; }
+        _id = nextID();
+        _tid = threadID();
+        _stream = stream;
+        _operation = operation;
+        _arg0 = arg0;
+        _arg1 = arg1;
+        _start = now();
+        emit(cpu_begin, _start, INT64_MIN, auxiliary);
+    }
+
+    void end(int64_t result, uint64_t output = UINT64_MAX) {
+        if (!_id) { return; }
+        const uint64_t finish = now();
+        emit(cpu_end, finish, result, output);
+        _id = 0;
+    }
+
+private:
+    static uint64_t threadID() {
+        static thread_local const uint64_t value = [] {
+            uint64_t tid = 0;
+#ifdef __APPLE__
+            if (pthread_threadid_np(nullptr, &tid)) { return uint64_t(0); }
+#endif
+            return tid; // Zero explicitly means unavailable on unsupported hosts.
+        }();
+        return value;
+    }
+
+    void emit(Kind kind, uint64_t timestamp, int64_t result, uint64_t output) const {
+        Record r;
+        r.kind = kind;
+        r.id = _id;
+        r.stream = _stream;
+        r.raw_ns = timestamp;
+        r.start_raw_ns = _start;
+        r.tid = _tid;
+        r.operation = _operation;
+        r.arg0 = _arg0;
+        r.arg1 = _arg1;
+        r.status = result;
+        r.auxiliary = output;
+        record(r);
+    }
+
+    uint64_t _id;
+    uint64_t _tid, _stream, _start, _arg0, _arg1;
+    Operation _operation;
+};
