+			}
+		}
+		const auto& offsets = vk._implicitBufferData[kMVKShaderStageFragment].dynamicOffsets;
+		if (index >= offsets.size() || index > INT32_MAX) {
+			result.status = Status::InvalidDynamicOffset;
