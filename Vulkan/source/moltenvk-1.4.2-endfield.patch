+// Record pipeline changes in the encoder's error report without enabling
+// expensive shader instrumentation. One encoder can contain many pipelines.
+static void recordEndfieldRenderPipeline(id<MTLRenderCommandEncoder> encoder,
+                                        id<MTLRenderPipelineState> pipeline) {
+	static const bool enabled = [] {
+		const char* value = getenv("ENDFIELD_RENDER_LABELS");
+		return value && strcmp(value, "1") == 0;
+	}();
+	if (!enabled || !mvk_endfield_labels::annotationsEnabled()) { return; }
