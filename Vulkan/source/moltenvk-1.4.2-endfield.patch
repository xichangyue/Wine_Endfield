+		"{\"type\":\"meta\",\"version\":1,\"pid\":%d,\"trace_id\":%llu,"
+		"\"command_buffer\":\"0x%llx\",\"metal_error_code\":%ld,\"render_labels_enabled\":%s,"
+		"\"compute_labels_enabled\":%s,\"encoder_capacity\":%u,"
+		"\"pipeline_capacity\":%u,\"attachment_capacity\":%u,\"recorded_encoders\":%u,\"dropped_encoders\":%u,"
