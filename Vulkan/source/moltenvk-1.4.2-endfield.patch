+#pragma once
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <objc/runtime.h>
+
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+// Bounded, opt-in identity breadcrumbs for Metal command-buffer failures.
+// The normal completion path performs no I/O. Records contain copied scalar
+// values only and never retain a Metal encoder, pipeline, texture, or buffer.
+namespace mvk_endfield_breadcrumbs {
+
+constexpr uint32_t MaxEncoders = 256;
+constexpr uint32_t MaxPipelineEvents = 4096;
+constexpr uint32_t MaxAttachments = 20; // 8 color + resolves, depth/stencil + resolves.
+constexpr uint32_t MaxAttachmentRecords = 2048;
+
+enum class EncoderKind : uint8_t { Render = 0, Compute = 1, Blit = 2 };
+enum class PipelineKind : uint8_t {
+	Graphics = 0, Compute = 1, TessVertex = 2, TessControl = 3, Helper = 4
+};
+
+enum AttachmentRole : uint8_t {
+	Color0 = 0,
+	ColorResolve0 = 8,
+	Depth = 16,
+	DepthResolve = 17,
+	Stencil = 18,
+	StencilResolve = 19,
+};
+
+struct AttachmentRecord {
+	uint64_t texture = 0;
+	uint64_t width = 0;
+	uint64_t height = 0;
+	uint64_t depth = 0;
+	uint64_t arrayLength = 0;
+	uint64_t mipmapLevelCount = 0;
+	uint64_t sampleCount = 0;
+	uint64_t level = 0;
+	uint64_t slice = 0;
+	uint64_t depthPlane = 0;
+	uint32_t pixelFormat = 0;
+	uint32_t textureType = 0;
+	uint32_t loadAction = 0;
+	uint32_t storeAction = 0;
+	uint8_t role = 0;
+};
+
+struct PipelineIdentity {
+	uint64_t object = 0;
+	uint64_t labelHash = 0;
+	uint64_t shaderHash[6] = {};
+	uint32_t stageMask = 0;
+	uint8_t parsedShaderLabel = 0;
+};
+
+struct PipelineEvent {
+	PipelineIdentity identity;
+	uint32_t encoderIndex = 0;
+	uint32_t sequence = 0;
+	uint8_t kind = 0;
+};
+
+struct EncoderRecord {
+	uint64_t encoder = 0;
+	uint64_t pipelineDigest = 1469598103934665603ULL;
+	PipelineIdentity lastPipeline;
+	uint32_t creationIndex = 0;
+	uint32_t commandUse = 0;
+	uint32_t pipelineTransitions = 0;
+	uint32_t pipelineEventsDropped = 0;
+	uint32_t attachmentStart = 0;
+	uint8_t attachmentCount = 0;
+	uint8_t attachmentsDropped = 0;
+	uint8_t kind = 0;
+	uint8_t ended = 0;
+};
+
+struct Trace {
+	uint64_t identity = 0;
+	uint64_t commandBuffer = 0;
+	uint32_t encodersDropped = 0;
+	uint32_t pipelineEventsDropped = 0;
+	uint32_t attachmentsDropped = 0;
+	uint32_t encoderCount = 0;
+	std::unique_ptr<EncoderRecord[]> encoders;
+	std::vector<AttachmentRecord> attachments;
+	std::vector<PipelineEvent> pipelineEvents;
+};
+
+using TracePtr = std::shared_ptr<Trace>;
+
+inline bool enabled() {
+	static const bool value = [] {
+		const char* flag = std::getenv("ENDFIELD_GPU_FAULT_BREADCRUMBS");
+		return flag && std::strcmp(flag, "1") == 0;
+	}();
+	return value;
+}
+
+inline const char* outputPath() {
+	static const char* value = [] {
+		const char* path = std::getenv("ENDFIELD_GPU_FAULT_BREADCRUMBS_PATH");
+		return path && path[0] == '/' ? path : static_cast<const char*>(nullptr);
+	}();
+	return value;
+}
+
+inline bool renderLabelsEnabled() {
+	static const bool value = [] {
+		const char* flag = std::getenv("ENDFIELD_RENDER_LABELS");
+		return flag && std::strcmp(flag, "1") == 0;
+	}();
+	return value;
+}
+
+inline bool computeLabelsEnabled() {
+	static const bool value = [] {
+		const char* flag = std::getenv("ENDFIELD_COMPUTE_LABELS");
+		return flag && std::strcmp(flag, "1") == 0;
+	}();
+	return value;
+}
+
+inline const void* traceKey() {
+	static char key;
+	return &key;
+}
+
+inline const void* encoderRecordKey() {
+	static char key;
+	return &key;
+}
+
+inline const void* encoderTraceKey() {
+	static char key;
+	return &key;
+}
+
+inline std::atomic<uint64_t>& nextTraceIdentity() {
+	static std::atomic<uint64_t> value {0};
+	return value;
+}
+
+inline uint64_t hashBytes(const char* bytes) {
+	uint64_t hash = 1469598103934665603ULL;
+	if (!bytes) { return 0; }
+	for (const unsigned char* p = reinterpret_cast<const unsigned char*>(bytes); *p; ++p) {
+		hash ^= *p;
+		hash *= 1099511628211ULL;
+	}
+	return hash;
+}
+
+inline uint64_t mix(uint64_t hash, uint64_t value) {
+	for (uint32_t i = 0; i < 8; ++i) {
+		hash ^= static_cast<uint8_t>(value >> (i * 8));
+		hash *= 1099511628211ULL;
+	}
+	return hash;
+}
+
+inline bool parseHex16(const char* text, uint64_t& value) {
+	value = 0;
+	if (!text) { return false; }
+	for (uint32_t i = 0; i < 16; ++i) {
+		unsigned char c = static_cast<unsigned char>(text[i]);
+		uint8_t digit;
+		if (c >= '0' && c <= '9') { digit = c - '0'; }
+		else if (c >= 'a' && c <= 'f') { digit = c - 'a' + 10; }
+		else if (c >= 'A' && c <= 'F') { digit = c - 'A' + 10; }
+		else { return false; }
+		value = (value << 4) | digit;
+	}
+	return true;
+}
+
+inline PipelineIdentity pipelineIdentity(id pipeline) {
+	PipelineIdentity result;
+	result.object = reinterpret_cast<uintptr_t>(pipeline);
+	NSString* label = pipeline ? [pipeline label] : nil;
+	const char* text = label.UTF8String;
+	result.labelHash = hashBytes(text);
+	if (!text) { return result; }
+
+	if (std::strncmp(text, "EFcs:", 5) == 0) {
+		uint64_t hash = 0;
+		if (parseHex16(text + 5, hash)) {
+			result.shaderHash[5] = hash;
+			result.stageMask = 1u << 5;
+			result.parsedShaderLabel = 1;
+		}
+		return result;
+	}
+	if (std::strncmp(text, "EFgfx:", 6) != 0) { return result; }
+
+	const char* part = text + 6;
+	while (*part) {
+		uint32_t stage = 0;
+		uint32_t prefix = 0;
+		if (part[0] == 'v') { stage = 0; prefix = 1; }
+		else if (part[0] == 't' && part[1] == 'c') { stage = 1; prefix = 2; }
+		else if (part[0] == 't' && part[1] == 'e') { stage = 2; prefix = 2; }
+		else if (part[0] == 'g') { stage = 3; prefix = 1; }
+		else if (part[0] == 'f') { stage = 4; prefix = 1; }
+		else { break; }
+		uint64_t hash = 0;
+		if (!parseHex16(part + prefix, hash)) { break; }
+		result.shaderHash[stage] = hash;
+		result.stageMask |= 1u << stage;
+		const char* slash = std::strchr(part + prefix + 16, '/');
+		if (!slash) { break; }
+		part = slash + 1;
+	}
+	result.parsedShaderLabel = result.stageMask != 0;
+	return result;
+}
+
+inline Trace* traceFor(id<MTLCommandBuffer> commandBuffer) {
+	NSValue* value = objc_getAssociatedObject(commandBuffer, traceKey());
+	return value ? static_cast<Trace*>(value.pointerValue) : nullptr;
+}
+
+inline EncoderRecord* recordFor(id<MTLCommandEncoder> encoder) {
+	NSValue* value = objc_getAssociatedObject(encoder, encoderRecordKey());
+	return value ? static_cast<EncoderRecord*>(value.pointerValue) : nullptr;
+}
+
+inline TracePtr createTrace(id<MTLCommandBuffer> commandBuffer) {
+	if (!enabled()) { return {}; }
+	if (!outputPath()) { return {}; }
+	auto trace = std::make_shared<Trace>();
+	trace->identity = nextTraceIdentity().fetch_add(1, std::memory_order_relaxed) + 1;
+	trace->commandBuffer = reinterpret_cast<uintptr_t>(commandBuffer);
+	objc_setAssociatedObject(commandBuffer, traceKey(),
+		[NSValue valueWithPointer:trace.get()], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+	return trace;
+}
+
+inline void captureAttachment(Trace& trace,
+							  EncoderRecord& record,
+							  uint8_t role,
+							  id<MTLTexture> texture,
+							  NSUInteger level,
+							  NSUInteger slice,
+							  NSUInteger depthPlane,
+							  MTLLoadAction loadAction,
+							  MTLStoreAction storeAction) {
+	if (!texture) { return; }
+	if (record.attachmentCount >= MaxAttachments || trace.attachments.size() >= MaxAttachmentRecords) {
+		++record.attachmentsDropped;
+		++trace.attachmentsDropped;
+		return;
+	}
+	if (trace.attachments.empty()) { trace.attachments.reserve(256); }
+	trace.attachments.emplace_back();
+	auto& item = trace.attachments.back();
+	++record.attachmentCount;
+	item.texture = reinterpret_cast<uintptr_t>(texture);
+	item.width = texture.width;
+	item.height = texture.height;
+	item.depth = texture.depth;
+	item.arrayLength = texture.arrayLength;
+	item.mipmapLevelCount = texture.mipmapLevelCount;
+	item.sampleCount = texture.sampleCount;
+	item.level = level;
+	item.slice = slice;
+	item.depthPlane = depthPlane;
+	item.pixelFormat = static_cast<uint32_t>(texture.pixelFormat);
+	item.textureType = static_cast<uint32_t>(texture.textureType);
+	item.loadAction = static_cast<uint32_t>(loadAction);
+	item.storeAction = static_cast<uint32_t>(storeAction);
+	item.role = role;
+}
+
+inline NSString* shortLabel(uint32_t index);
+
+inline EncoderRecord* registerEncoder(id<MTLCommandBuffer> commandBuffer,
+								  id<MTLCommandEncoder> encoder,
+								  EncoderKind kind,
+								  uint32_t commandUse) {
+	if (!enabled() || !commandBuffer || !encoder) { return nullptr; }
+	if (auto* existing = recordFor(encoder)) {
+		bool useChanged = existing->commandUse != commandUse;
+		existing->commandUse = commandUse;
+		if (useChanged) { encoder.label = shortLabel(existing->creationIndex); }
+		return existing;
+	}
+	Trace* trace = traceFor(commandBuffer);
+	if (!trace) { return nullptr; }
+	if (trace->encoderCount >= MaxEncoders) {
+		++trace->encodersDropped;
+		return nullptr;
+	}
+	if (!trace->encoders) {
+		trace->encoders.reset(new (std::nothrow) EncoderRecord[MaxEncoders]);
+		if (!trace->encoders) { ++trace->encodersDropped; return nullptr; }
+	}
+	auto& record = trace->encoders[trace->encoderCount];
+	record.encoder = reinterpret_cast<uintptr_t>(encoder);
+	record.creationIndex = trace->encoderCount++;
+	record.commandUse = commandUse;
+	record.kind = static_cast<uint8_t>(kind);
+	objc_setAssociatedObject(encoder, encoderRecordKey(),
+		[NSValue valueWithPointer:&record], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+	objc_setAssociatedObject(encoder, encoderTraceKey(),
+		[NSValue valueWithPointer:trace], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+	encoder.label = shortLabel(record.creationIndex);
+	return &record;
+}
+
+inline void registerRenderEncoder(id<MTLCommandBuffer> commandBuffer,
+								  id<MTLRenderCommandEncoder> encoder,
+								  uint32_t commandUse,
+								  MTLRenderPassDescriptor* descriptor) {
+	auto* record = registerEncoder(commandBuffer, encoder, EncoderKind::Render, commandUse);
+	if (!record || !descriptor || record->attachmentCount) { return; }
+	Trace* trace = traceFor(commandBuffer);
+	if (!trace) { return; }
+	record->attachmentStart = static_cast<uint32_t>(trace->attachments.size());
+	for (uint32_t i = 0; i < 8; ++i) {
+		auto* attachment = descriptor.colorAttachments[i];
+		captureAttachment(*trace, *record, static_cast<uint8_t>(Color0 + i), attachment.texture,
+			attachment.level, attachment.slice, attachment.depthPlane,
+			attachment.loadAction, attachment.storeAction);
+		captureAttachment(*trace, *record, static_cast<uint8_t>(ColorResolve0 + i), attachment.resolveTexture,
+			attachment.resolveLevel, attachment.resolveSlice, attachment.resolveDepthPlane,
+			attachment.loadAction, attachment.storeAction);
+	}
+	auto* depth = descriptor.depthAttachment;
+	captureAttachment(*trace, *record, Depth, depth.texture, depth.level, depth.slice, depth.depthPlane,
+		depth.loadAction, depth.storeAction);
+	captureAttachment(*trace, *record, DepthResolve, depth.resolveTexture, depth.resolveLevel,
+		depth.resolveSlice, depth.resolveDepthPlane, depth.loadAction, depth.storeAction);
+	auto* stencil = descriptor.stencilAttachment;
+	captureAttachment(*trace, *record, Stencil, stencil.texture, stencil.level, stencil.slice,
+		stencil.depthPlane, stencil.loadAction, stencil.storeAction);
+	captureAttachment(*trace, *record, StencilResolve, stencil.resolveTexture, stencil.resolveLevel,
+		stencil.resolveSlice, stencil.resolveDepthPlane, stencil.loadAction, stencil.storeAction);
+}
+
+inline void recordPipeline(id<MTLCommandEncoder> encoder, id pipeline, PipelineKind kind) {
+	if (!enabled() || !encoder || !pipeline) { return; }
+	EncoderRecord* record = recordFor(encoder);
+	if (!record) { return; }
+	PipelineIdentity identity = pipelineIdentity(pipeline);
+	if (record->pipelineTransitions &&
+		record->lastPipeline.object == identity.object &&
+		record->lastPipeline.labelHash == identity.labelHash) { return; }
+	++record->pipelineTransitions;
+	record->lastPipeline = identity;
+	record->pipelineDigest = mix(record->pipelineDigest, identity.labelHash);
+	record->pipelineDigest = mix(record->pipelineDigest, identity.stageMask);
+	for (uint64_t shaderHash : identity.shaderHash) {
+		record->pipelineDigest = mix(record->pipelineDigest, shaderHash);
+	}
+	// EncoderRecord addresses are stable in Trace's fixed allocation. The owner
+	// pointer is used only while the command buffer's captured
+	// shared_ptr is alive during encoding.
+	NSValue* ownerValue = objc_getAssociatedObject(encoder, encoderTraceKey());
+	Trace* trace = ownerValue ? static_cast<Trace*>(ownerValue.pointerValue) : nullptr;
+	if (!trace || trace->pipelineEvents.size() >= MaxPipelineEvents) {
+		++record->pipelineEventsDropped;
+		if (trace) { ++trace->pipelineEventsDropped; }
+		return;
+	}
+	if (trace->pipelineEvents.empty()) { trace->pipelineEvents.reserve(256); }
+	PipelineEvent event;
+	event.identity = identity;
+	event.encoderIndex = record->creationIndex;
+	event.sequence = record->pipelineTransitions;
+	event.kind = static_cast<uint8_t>(kind);
+	trace->pipelineEvents.push_back(event);
+}
+
+inline EncoderRecord* registerTrackedEncoder(id<MTLCommandBuffer> commandBuffer,
+									 id<MTLCommandEncoder> encoder,
+									 EncoderKind kind,
+									 uint32_t commandUse) {
+	return registerEncoder(commandBuffer, encoder, kind, commandUse);
+}
+
+inline void registerTrackedRenderEncoder(id<MTLCommandBuffer> commandBuffer,
+									 id<MTLRenderCommandEncoder> encoder,
+									 uint32_t commandUse,
+									 MTLRenderPassDescriptor* descriptor) {
+	registerRenderEncoder(commandBuffer, encoder, commandUse, descriptor);
+}
+
+inline NSString* shortLabel(uint32_t index) {
+	static std::array<NSString*, MaxEncoders> labels = {};
+	static std::once_flag flag;
+	std::call_once(flag, [] {
+		for (uint32_t i = 0; i < MaxEncoders; ++i) {
+			labels[i] = [[NSString alloc] initWithFormat:@"EFb:%03u", i];
+		}
+	});
+	return labels[index];
+}
+
+inline void finishEncoder(id<MTLCommandEncoder> encoder) {
+	if (!enabled() || !encoder) { return; }
+	EncoderRecord* record = recordFor(encoder);
+	if (!record || record->creationIndex >= MaxEncoders) { return; }
+	record->ended = 1;
+	NSString* expected = shortLabel(record->creationIndex);
+	if (![encoder.label isEqualToString:expected]) { encoder.label = expected; }
+}
+
+inline bool parseShortLabel(NSString* label, uint32_t& index) {
+	const char* text = label.UTF8String;
+	if (!text || std::strlen(text) != 7 || std::strncmp(text, "EFb:", 4) != 0) { return false; }
+	index = 0;
+	for (uint32_t i = 4; i < 7; ++i) {
+		if (text[i] < '0' || text[i] > '9') { return false; }
+		index = index * 10 + static_cast<uint32_t>(text[i] - '0');
+	}
+	return index < MaxEncoders;
+}
+
+inline void writeError(const TracePtr& trace, id<MTLCommandBuffer> commandBuffer) {
+	if (!trace || !trace->encoderCount || commandBuffer.status != MTLCommandBufferStatusError) { return; }
+	const char* path = outputPath();
+	if (!path || ::access(path, F_OK) == 0) { return; }
+	std::string temporaryPath(path);
+	temporaryPath += ".tmp." + std::to_string(getpid()) + "." + std::to_string(trace->identity);
+	int fd = ::open(temporaryPath.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0) {
+		std::fprintf(stderr, "Endfield GPU fault breadcrumb output failed (errno=%d).\n", errno);
+		return;
+	}
+	FILE* file = ::fdopen(fd, "w");
