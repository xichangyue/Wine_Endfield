+// Scalar diagnostics for the exact fullscreen pair. Each descriptor has its own
+// result: a failed UBO check must never suppress the texture snapshot.
+static mvk_endfield_resources::Snapshot snapshotEndfieldTargetResources(
+  MVKCommandEncoder& mvkEncoder, const MVKVulkanGraphicsCommandEncoderState& vk,
+  bool vertexBound, const MVKStageResourceBindings::Buffer& vertexArgument,
