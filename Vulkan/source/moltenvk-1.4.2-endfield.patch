+            do { written = ::write(_fd, line, static_cast<size_t>(n)); } while (written < 0 && errno == EINTR);
+        }
+        if (written != n || n <= 0 || n >= static_cast<int>(sizeof(line))) {
+            _ioError = true;
+            std::fprintf(stderr, "Endfield target UBO diagnostics output incomplete.\n");
+        }
+    }
+    bool _enabled = false, _ioError = false;
+    int _fd = -1, _pid = 0;
+    std::atomic<bool> _frozen{false};
+    std::mutex _lock;
+    std::mutex _checkpointIOLock;
+    int _checkpointFd = -1;
+    bool _checkpointIOError = false;
+    std::unique_ptr<Snapshot[]> _ring;
+    std::unique_ptr<uint32_t[]> _freeIndices;
+    std::unique_ptr<uint32_t[]> _nextSlot;
+    std::unique_ptr<uint32_t[]> _exportOrder;
+    std::string _firstTargetPath;
+    size_t _freeHead = 0, _freeCount = Capacity;
+    uint64_t _lastCheckpointNS = 0;
+    uint64_t _retained = 0, _overwritten = 0, _dropped = 0;
+    uint64_t _total = 0, _nextObjectID = 0;
+};
+
+// Process-lifetime diagnostic state intentionally outlives static destructors.
+// No resource is retained, and the OS reclaims its bounded storage at exit.
+inline State& state() { static State* value = new State; return *value; }
+inline bool enabled() { return state().accepting(); }
+inline void exportAtExit() { state().freezeAndExport(nil, 0, "process_exit"); }
+inline void freezeAndExport(id<MTLCommandBuffer> cb, int64_t code) {
+    state().freezeAndExport(cb, code, "gpu_error");
+}
+inline void completed(id<MTLCommandBuffer> cb) { state().completed(cb); }
+
+} // namespace mvk_endfield_ubo
