+			"\"last_label_hash\":\"%016llx\",\"last_stage_mask\":%u,\"last_label_parsed\":%s,"
+			"\"last_shader_v\":\"%016llx\",\"last_shader_tc\":\"%016llx\","
+			"\"last_shader_te\":\"%016llx\",\"last_shader_g\":\"%016llx\","
+			"\"last_shader_f\":\"%016llx\",\"last_shader_c\":\"%016llx\"}\n",
+			record.creationIndex, record.kind, record.commandUse,
+			(unsigned long long)record.encoder, record.ended ? "true" : "false",
+			errorOrdinal[record.creationIndex], errorState[record.creationIndex], record.attachmentCount,
+			record.attachmentsDropped,
