+		result.bufferGPUAddress = buffer.gpuAddress;
+		result.storageMode = static_cast<int32_t>(buffer.storageMode);
+		if (result.bufferGPUAddress > UINT64_MAX - result.descriptorOffset) {
+			result.status = Status::InvalidBounds;
+			return result;
+		}
+		result.expectedGPUAddress = result.bufferGPUAddress + result.descriptorOffset;
+		result.addressMatches = result.expectedGPUAddress == result.gpuDescriptorAddress;
+		if (!result.addressMatches || !result.rangeMatches) {
+			result.status = Status::DescriptorMismatch;
+			return result;
+		}
+		if (result.descriptorRange < 44 || !fits(result.effectiveOffset, result.descriptorRange, result.bufferLength)) {
+			result.status = Status::InvalidBounds;
+			return result;
+		}
