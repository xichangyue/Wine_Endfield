+// Owned by an associated NSMutableData on the command buffer, never the reverse.
+// Mutable fields are accessed only under State::_lock. The association is set once.
+struct CommandBufferState {
+    uint64_t identity;
+    uint64_t dropped;
+    uint32_t head;
+    bool completed;
+};
+
+inline uint64_t nowNS() {
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC_RAW, &ts);
+    return uint64_t(ts.tv_sec) * 1000000000ULL + uint64_t(ts.tv_nsec);
