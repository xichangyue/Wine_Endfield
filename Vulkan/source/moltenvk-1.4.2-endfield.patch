+// Encoders can contain several dispatches. Preserve their labels as a bounded
+// list instead of incorrectly attributing the whole encoder to its last dispatch.
+static void labelEndfieldDispatch(id<MTLComputeCommandEncoder> encoder,
+								 MVKComputePipeline* pipeline, MTLSize groups, bool indirect = false) {
+	static const bool enabled = [] {
+		const char* value = getenv("ENDFIELD_COMPUTE_LABELS");
+		return value && strcmp(value, "1") == 0;
+	}();
+	if (!enabled || !mvk_endfield_labels::annotationsEnabled()) { return; }
+	if (mvk_endfield_labels::enabled()) {
+		mvk_endfield_labels::recordCompute(encoder, pipeline->getPipelineState().label,
+			groups, pipeline->getThreadgroupSize(), indirect);
+		return;
+	}
+	NSString* old = encoder.label ?: @"";
+	if ([old hasSuffix: @" [more dispatches]"]) { return; }
+	if (old.length > 2048) {
+		encoder.label = [old stringByAppendingString: @" [more dispatches]"];
+		return;
+	}
+	const auto& tg = pipeline->getThreadgroupSize();
+	NSString* grid = indirect ? @"indirect" : [NSString stringWithFormat: @"%lux%lux%lu",
+		(unsigned long)groups.width, (unsigned long)groups.height, (unsigned long)groups.depth];
+	NSString* detail = [NSString stringWithFormat: @"%@ grid=%@ tg=%lux%lux%lu",
+		pipeline->getPipelineState().label ?: @"EFcs:unknown", grid,
+		(unsigned long)tg.width, (unsigned long)tg.height, (unsigned long)tg.depth];
+	encoder.label = [old stringByAppendingFormat: @" | %@", detail];
+}
