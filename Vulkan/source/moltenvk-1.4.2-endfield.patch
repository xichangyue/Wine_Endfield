+#pragma once
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <objc/runtime.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+// Diagnostic text only: no resource retention, synchronization, or GPU commands
+// beyond the existing render signposts. The encoder owns its bounded builder.
+namespace mvk_endfield_labels {
+
+// Opt out only of encoder annotations; PSO names and shader dumps stay independent.
+inline bool annotationsEnabled() {
+	static const bool value = [] {
+		const char* flag = getenv("ENDFIELD_ENCODER_ANNOTATIONS");
+		return !flag || strcmp(flag, "0") != 0;
+	}();
+	return value;
+}
+
+inline bool enabled() {
+	static const bool value = [] {
+		const char* flag = getenv("ENDFIELD_BATCH_ENCODER_LABELS");
+		return flag && strcmp(flag, "1") == 0;
+	}();
+	return annotationsEnabled() && value;
+}
+
+constexpr NSUInteger RenderLimit = 4096;
+constexpr NSUInteger ComputeLimit = 2048;
+
+inline const void* builderKey() {
+	static char key;
+	return &key;
+}
+
+inline void append(NSMutableString* text, NSString* part, NSUInteger limit, NSString* marker) {
+	if ([text hasSuffix:marker]) { return; }
+	// Keep complete pieces and explicitly mark omitted text. No partial UTF-16
+	// character or unbounded pipeline/debug name is copied at the size limit.
+	if (part.length > limit - text.length) {
+		[text appendString:marker];
+	} else {
+		[text appendString:part];
+	}
+}
+
+inline NSMutableString* builder(id<MTLCommandEncoder> encoder, NSUInteger limit, NSString* marker) {
+	NSMutableString* text = objc_getAssociatedObject(encoder, builderKey());
+	if (!text) {
+		text = [[NSMutableString alloc] initWithCapacity:256];
+		append(text, encoder.label ?: @"Encoder", limit, marker);
+		objc_setAssociatedObject(encoder, builderKey(), text, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+		[text release];
+	}
+	return text;
+}
+
+inline void recordRender(id<MTLRenderCommandEncoder> encoder, NSString* pipelineLabel) {
+	if (!enabled() || !encoder) { return; }
+	NSString* label = pipelineLabel ?: @"EFgfx:unlabelled-helper";
+	[encoder insertDebugSignpost:label];
+	NSString* marker = @" [more pipelines]";
+	NSMutableString* text = builder(encoder, RenderLimit, marker);
+	append(text, @" | ", RenderLimit, marker);
+	append(text, label, RenderLimit, marker);
+}
+
+inline void recordCompute(id<MTLComputeCommandEncoder> encoder, NSString* pipelineLabel,
+						  MTLSize groups, MTLSize threads, bool indirect) {
+	if (!enabled() || !encoder) { return; }
+	NSString* marker = @" [more dispatches]";
+	NSMutableString* text = builder(encoder, ComputeLimit, marker);
+	if ([text hasSuffix:marker]) { return; }
+	char suffix[256];
+	if (indirect) {
+		snprintf(suffix, sizeof(suffix), " grid=indirect tg=%lux%lux%lu",
+			(unsigned long)threads.width, (unsigned long)threads.height, (unsigned long)threads.depth);
+	} else {
+		snprintf(suffix, sizeof(suffix), " grid=%lux%lux%lu tg=%lux%lux%lu",
+			(unsigned long)groups.width, (unsigned long)groups.height, (unsigned long)groups.depth,
+			(unsigned long)threads.width, (unsigned long)threads.height, (unsigned long)threads.depth);
+	}
+	append(text, @" | ", ComputeLimit, marker);
+	append(text, pipelineLabel ?: @"EFcs:unknown", ComputeLimit, marker);
+	append(text, [NSString stringWithUTF8String:suffix], ComputeLimit, marker);
+}
+
+// Call after the existing command-use label setter. Preserve dispatch history
+// when a compute encoder is reused for another command use.
+inline void noteBaseChange(id<MTLCommandEncoder> encoder) {
+	if (!enabled() || !encoder) { return; }
+	NSMutableString* text = objc_getAssociatedObject(encoder, builderKey());
+	if (!text) { return; }
+	append(text, @" | use=", ComputeLimit, @" [more dispatches]");
+	append(text, encoder.label ?: @"Encoder", ComputeLimit, @" [more dispatches]");
+}
+
+inline void flush(id<MTLCommandEncoder> encoder) {
+	if (!enabled() || !encoder) { return; }
+	NSMutableString* text = objc_getAssociatedObject(encoder, builderKey());
+	if (!text) { return; }
+	// Metal copies label. Submit the accumulated list once before endEncoding,
+	// then release the builder; no command buffer has been committed yet.
+	encoder.label = text;
+	objc_setAssociatedObject(encoder, builderKey(), nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+} // namespace mvk_endfield_labels
