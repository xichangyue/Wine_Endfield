+                "\"id_namespace\":\"endfield_target_resources_only\",\"target_vertex_hash\":\"a4a855eec0437744\",\"target_fragment_hash\":\"f50e58483a8e93fe\",\"scope\":\"cpu_encode_resource_snapshot_of_completed_command_buffer\",\"interval_ns\":%llu}\n",
+                _pid, (unsigned long long)CheckpointIntervalNS);
