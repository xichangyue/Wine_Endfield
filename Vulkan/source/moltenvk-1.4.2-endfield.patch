+private:
+    // Associations are diagnostic NSNumber identities only, not resource retains.
+    // They disappear with the Metal object and avoid pointer-reuse ambiguity.
+    uint64_t objectID(id object, bool encoder, bool create = true) {
+        if (!object) { return 0; }
+        static char commandBufferKey, encoderKey;
+        const void* key = encoder ? &encoderKey : &commandBufferKey;
+        NSNumber* value = objc_getAssociatedObject(object, key);
+        if (!value && !create) { return 0; }
+        if (!value) {
+            value = [NSNumber numberWithUnsignedLongLong:++_nextObjectID];
+            objc_setAssociatedObject(object, key, value, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        return value.unsignedLongLongValue;
+    }
+    CommandBufferState* commandBufferState(id object, bool create) {
+        if (!object) { return nullptr; }
+        static char key;
+        NSMutableData* storage = objc_getAssociatedObject(object, &key);
+        if (!storage && create) {
+            storage = [NSMutableData dataWithLength:sizeof(CommandBufferState)];
+            if (!storage) { return nullptr; }
+            auto* value = new (storage.mutableBytes) CommandBufferState{};
+            value->identity = ++_nextObjectID;
+            value->head = NoSlot;
+            objc_setAssociatedObject(object, &key, storage, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        return storage ? const_cast<CommandBufferState*>(static_cast<const CommandBufferState*>(storage.bytes)) : nullptr;
+    }
+    void writeCheckpoint(const Snapshot& s, uint64_t completedNS, uint64_t total, uint64_t dropped, uint64_t cbDropped) {
+        JsonLine line;
+        formatSnapshot(line, s, "checkpoint", false, completedNS, total, dropped, cbDropped);
+        writeCheckpointLine(line.text, line.good ? int(line.used) : -1, sizeof(line.text));
+        bool expected = false;
+        if (_firstCompletedWritten.compare_exchange_strong(expected, true)) { writeFirstTarget(s); }
+    }
+    void writeCheckpointLine(const char* line, int length, size_t capacity) {
+        // This lock/fd is independent of main export and is never closed by it.
+        // No render/resource/ring lock is held here. OS exit closes the fd.
+        std::lock_guard<std::mutex> lock(_checkpointIOLock);
+        if (_checkpointFd < 0 || _checkpointIOError) { return; }
+        ssize_t written = -1;
+        if (length > 0 && static_cast<size_t>(length) < capacity) {
+            do { written = ::write(_checkpointFd, line, static_cast<size_t>(length)); } while (written < 0 && errno == EINTR);
+        }
+        if (written != length || length <= 0 || static_cast<size_t>(length) >= capacity) {
+            _checkpointIOError = true;
+            std::fprintf(stderr, "Endfield target resource checkpoint output incomplete.\n");
+        }
+    }
+    void writeFirstTarget(const Snapshot& s) {
+        int fd = ::open(_firstTargetPath.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+        if (fd < 0) {
+            std::fprintf(stderr, "Endfield target resource first-target sidecar unavailable (errno=%d).\n", errno);
+            return;
+        }
+        JsonLine line;
+        formatSnapshot(line, s, "first_completed_target", false);
+        ssize_t written = -1;
+        if (line.good) {
+            do { written = ::write(fd, line.text, line.used); } while (written < 0 && errno == EINTR);
+        }
+        if (!line.good || written != static_cast<ssize_t>(line.used)) {
+            std::fprintf(stderr, "Endfield target resource first-target sidecar incomplete.\n");
+        }
+        ::close(fd);
+    }
+    __attribute__((format(printf, 2, 3))) void append(const char* format, ...) {
+        if (_fd < 0 || _ioError) { return; }
+        char line[16384];
+        va_list args; va_start(args, format);
+        int n = std::vsnprintf(line, sizeof(line), format, args);
+        va_end(args);
+        ssize_t written = -1;
+        if (n > 0 && n < static_cast<int>(sizeof(line))) {
+            do { written = ::write(_fd, line, static_cast<size_t>(n)); } while (written < 0 && errno == EINTR);
+        }
+        if (written != n || n <= 0 || n >= static_cast<int>(sizeof(line))) {
+            _ioError = true;
+            std::fprintf(stderr, "Endfield target resource diagnostics output incomplete.\n");
+        }
+    }
+    uint64_t _faultID=0, _faultDropped=0, _freezeNS=0;
+    uintptr_t _faultPointer=0;
+    int64_t _errorCode=0;
