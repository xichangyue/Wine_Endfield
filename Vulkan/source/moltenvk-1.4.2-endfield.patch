+        _ring.reset(new (std::nothrow) Snapshot[Capacity]);
+        _freeIndices.reset(new (std::nothrow) uint32_t[Capacity]);
+        _nextSlot.reset(new (std::nothrow) uint32_t[Capacity]);
+        _exportOrder.reset(new (std::nothrow) uint32_t[Capacity]);
+        if (!_ring || !_freeIndices || !_nextSlot || !_exportOrder) { return; }
