+		// Keep the complete temporary report when publication itself fails. This
+		// is the only recoverable copy and the launcher removes stale siblings
+		// before a later run.
+		std::fprintf(stderr,
+			"Endfield GPU fault breadcrumb publish failed (errno=%d, report=%s).\n",
+			errno, temporaryPath.c_str());
+	}
+}
+
+inline void complete(const TracePtr& trace, id<MTLCommandBuffer> commandBuffer) {
+	if (!trace) { return; }
+	writeError(trace, commandBuffer);
+	objc_setAssociatedObject(commandBuffer, traceKey(), nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
