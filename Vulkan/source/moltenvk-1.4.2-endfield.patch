+			"\"shader_te\":\"%016llx\",\"shader_g\":\"%016llx\","
+			"\"shader_f\":\"%016llx\",\"shader_c\":\"%016llx\"}\n",
+			event.encoderIndex, event.sequence, event.kind,
+			(unsigned long long)p.object, (unsigned long long)p.labelHash, p.stageMask,
+			p.parsedShaderLabel ? "true" : "false",
+			(unsigned long long)p.shaderHash[0], (unsigned long long)p.shaderHash[1],
+			(unsigned long long)p.shaderHash[2], (unsigned long long)p.shaderHash[3],
+			(unsigned long long)p.shaderHash[4], (unsigned long long)p.shaderHash[5]);
+	}
+	for (NSUInteger ordinal = 0; ordinal < infos.count; ++ordinal) {
+		id<MTLCommandBufferEncoderInfo> info = infos[ordinal];
+		uint32_t index = 0;
+		bool valid = parseShortLabel(info.label, index) && index < trace->encoderCount;
+		std::fprintf(file,
+			"{\"type\":\"metal_encoder_info\",\"ordinal\":%lu,\"state\":%ld,"
