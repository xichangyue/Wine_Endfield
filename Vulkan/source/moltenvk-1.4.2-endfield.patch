+    bool accepting() const { return _enabled && !_frozen.load(std::memory_order_relaxed); }
+
+    uint64_t record(Snapshot snapshot, id<MTLCommandBuffer> cb, id<MTLRenderCommandEncoder> encoder) {
+        if (!accepting()) { return 0; }
+        {
+            std::lock_guard<std::mutex> lock(_lock);
+            if (_frozen.load(std::memory_order_relaxed)) { return 0; }
+            CommandBufferState* cbState = commandBufferState(cb, true);
+            if (!cbState || cbState->completed) { return 0; }
+            snapshot.snapshotID = ++_total;
+            snapshot.commandBufferID = cbState->identity;
+            snapshot.encoderID = objectID(encoder, true);
+            snapshot.commandBuffer = reinterpret_cast<uintptr_t>(cb);
+            snapshot.encoder = reinterpret_cast<uintptr_t>(encoder);
+            if (!_freeCount) { ++_dropped; ++cbState->dropped; return 0; }
+            uint32_t slot = _freeIndices[_freeHead];
+            _freeHead = (_freeHead + 1) % Capacity;
+            --_freeCount;
+            if (_ring[slot].snapshotID) { ++_overwritten; }
+            else { ++_retained; }
+            _ring[slot] = snapshot;
+            _nextSlot[slot] = cbState->head;
+            cbState->head = slot;
+        }
+        return snapshot.snapshotID;
+    }
+
+    void completed(id<MTLCommandBuffer> cb) {
+        if (!accepting()) { return; }
+        // A command buffer without target draws never acquires the ring mutex.
+        CommandBufferState* cbState = commandBufferState(cb, false);
+        if (!cbState) { return; }
+        Snapshot checkpoint;
+        uint64_t completedNS = 0, total = 0, dropped = 0, cbDropped = 0;
+        bool emitCheckpoint = false;
+        {
+            std::lock_guard<std::mutex> lock(_lock);
+            if (_frozen.load(std::memory_order_relaxed) || cbState->completed) { return; }
+            uint32_t slot = cbState->head;
+            cbState->head = NoSlot;
+            cbState->completed = true;
+            if (_checkpointFd >= 0 && slot < Capacity && _ring[slot].commandBufferID == cbState->identity) {
+                completedNS = nowNS();
+                if (!_lastCheckpointNS || completedNS - _lastCheckpointNS >= CheckpointIntervalNS) {
+                    checkpoint = _ring[slot]; // Latest encoded draw in this completed command buffer.
+                    _lastCheckpointNS = completedNS;
+                    total = _total;
+                    dropped = _dropped;
+                    cbDropped = cbState->dropped;
+                    emitCheckpoint = true;
+                }
+            }
+            size_t traversed = 0;
+            while (slot < Capacity && traversed++ < Capacity) {
+                if (_ring[slot].commandBufferID != cbState->identity || _freeCount == Capacity) { break; }
+                uint32_t next = _nextSlot[slot];
+                _nextSlot[slot] = NoSlot;
+                _freeIndices[(_freeHead + _freeCount) % Capacity] = slot;
+                ++_freeCount;
+                slot = next;
+            }
+        }
+        // The independent checkpoint fd is never closed or written by main export.
+        // This completed-history sample can finish even if error freezing races it.
+        if (emitCheckpoint) { writeCheckpoint(checkpoint, completedNS, total, dropped, cbDropped); }
+    }
+
+    // Freeze is separate from I/O so Queue can freeze this before exporting the old collector.
+    bool freeze(id<MTLCommandBuffer> cb, int64_t errorCode, const char* reason) {
+        if (!_enabled) return false;
+        bool expected=false;
+        if (!_frozen.compare_exchange_strong(expected,true)) return false;
+        _freezeNS=nowNS();
+        std::lock_guard<std::mutex> lock(_lock);
+        if (cb) {
+            CommandBufferState* value=commandBufferState(cb,true);
+            if (value) { _faultID=value->identity; _faultDropped=value->dropped; }
+        }
+        _faultPointer=reinterpret_cast<uintptr_t>(cb);
+        _errorCode=errorCode;
+        std::snprintf(_reason,sizeof(_reason),"%s",reason);
+        return true; // Only this caller may exportFrozen().
+    }
+    void freezeAndExport(id<MTLCommandBuffer> cb, int64_t errorCode, const char* reason) {
+        if (freeze(cb,errorCode,reason)) exportFrozen();
+    }
+    void exportFrozen() {
+        const uint64_t faultID=_faultID, faultDropped=_faultDropped, freezeNS=_freezeNS;
