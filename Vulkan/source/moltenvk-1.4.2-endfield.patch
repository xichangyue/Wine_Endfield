+		mvk_endfield_labels::recordRender(encoder, label);
+		return;
+	}
+	[encoder insertDebugSignpost:label];
+	NSString* previous = encoder.label ?: @"RenderEncoder";
+	if (previous.length < 4096) {
+		encoder.label = [previous stringByAppendingFormat:@" | %@", label];
+	} else if (![previous hasSuffix:@" [more pipelines]"]) {
+		encoder.label = [previous stringByAppendingString:@" [more pipelines]"];
+	}
