+#endif
+    int fd = ::open(path, flags, 0600);
+    if (fd < 0) { if (imagePin) { ::dlclose(imagePin); } return false; }
+    State* state = nullptr;
+    try {
+        state = new State(fd);
+        state->imagePin = imagePin;
+        state->imageIsExecutable = imageIsExecutable;
+        state->writer = std::thread(&writerEntry, state);
+    } catch (...) {
+        ::close(fd);
+        delete state; // Thread construction failure leaves writer non-joinable.
+        if (imagePin) { ::dlclose(imagePin); }
+        return false;
+    }
+    published().store(state, std::memory_order_release);
+    return true;
+}
