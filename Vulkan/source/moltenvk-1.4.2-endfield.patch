+#pragma once
+
+// Speculative library creation only. No MVK owner/cache/library pointers and no
+// Vulkan configuration errors. Callers adopt only a completed successful result.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <dlfcn.h>
+#include <limits.h>
+#include <memory>
+#include <mutex>
+#include <sys/stat.h>
+#include <unistd.h>
+#ifdef __APPLE__
+#include <mach-o/dyld.h>
+#endif
+
+namespace mvk_endfield_prewarm {
+
+using Clock = std::chrono::steady_clock;
+enum class Status { Pending, Success, Failed };
+class Job;
+using JobPtr = std::shared_ptr<Job>;
+
+namespace detail {
+
+inline std::atomic<unsigned>& slots() { static std::atomic<unsigned> value{0}; return value; }
+inline void executeJob(const JobPtr& job);
+
+inline bool sameFile(const char* a, const char* b) {
+    struct stat x, y;
+    return a && b && !::stat(a, &x) && !::stat(b, &y) && x.st_dev == y.st_dev && x.st_ino == y.st_ino;
+}
+
+inline bool pinCodeImpl() {
+    Dl_info info = {};
+    if (!::dladdr(reinterpret_cast<const void*>(&executeJob), &info) || !info.dli_fname) { return false; }
+    char executable[PATH_MAX] = {};
+#ifdef __APPLE__
+    uint32_t length = sizeof(executable);
+    if (_NSGetExecutablePath(executable, &length)) { return false; }
+#elif defined(__linux__)
+    ssize_t length = ::readlink("/proc/self/exe", executable, sizeof(executable) - 1);
+    if (length <= 0 || size_t(length) >= sizeof(executable) - 1) { return false; }
+    executable[length] = 0;
+#else
+    return false;
+#endif
+    if (sameFile(info.dli_fname, executable)) { return true; }
+    char resolved[PATH_MAX];
+    if (!::realpath(info.dli_fname, resolved) || !sameFile(info.dli_fname, resolved)) { return false; }
+    int flags = RTLD_LAZY | RTLD_LOCAL;
+#ifdef RTLD_NODELETE
+    flags |= RTLD_NODELETE;
+#endif
+    // Deliberately never dlclose this reference: an async API or callback can
+    // outlive its caller's finite deadline and original dylib reference.
+    return ::dlopen(resolved, flags) != nullptr;
+}
+
+inline bool pinCode() { static const bool value = pinCodeImpl(); return value; }
+
+struct Reservation {
+    bool active = false;
+    Reservation() {
+        unsigned count = slots().load(std::memory_order_relaxed);
+        if (count < 2) {
+            active = slots().compare_exchange_strong(count, count + 1, std::memory_order_acq_rel);
+        }
+        // Contention may conservatively skip a free slot; never wait or spin.
+    }
+    ~Reservation() { if (active) { slots().fetch_sub(1, std::memory_order_acq_rel); } }
+};
+
+struct Inputs {
+    id<MTLDevice> device = nil;
+    NSString* source = nil;
+    MTLCompileOptions* options = nil;
+    ~Inputs() { [options release]; [source release]; [device release]; }
+};
+
+#ifdef MVK_ENDFIELD_PREWARM_TEST
+using Completion = void (^)(id<MTLLibrary>, NSError*);
+using Submit = void (*)(id<MTLDevice>, NSString*, MTLCompileOptions*, Completion);
+inline std::atomic<Submit>& testSubmit() { static std::atomic<Submit> value{nullptr}; return value; }
+#endif
+
+} // namespace detail
+
+class Job {
+public:
+    explicit Job(std::shared_ptr<detail::Inputs> inputs) : _inputs(std::move(inputs)) {}
+    ~Job() { [_library release]; }
+
+    Status status() const { return _status.load(std::memory_order_acquire); }
+
+    // true means terminal (success OR failure). A timeout neither cancels Metal
+    // work nor mutates a cache. The caller can safely inspect status afterwards.
+    bool waitUntil(Clock::time_point deadline) {
+        if (status() != Status::Pending) { return true; }
+        std::unique_lock<std::mutex> lock(_lock);
+        return _changed.wait_until(lock, deadline, [this] { return status() != Status::Pending; });
+    }
+
+    // A successful result is immutable after release-publishing terminal status.
+    // Caller holds a JobPtr and must release this additional library reference.
+    id<MTLLibrary> copySuccessfulLibrary() const {
+        return status() == Status::Success ? [_library retain] : nil;
+    }
+
+    // Internal callback entry points; do not call from a cache or owner teardown.
+    void completed(id<MTLLibrary> library) {
+        {
+            std::lock_guard<std::mutex> lock(_lock);
+            if (_callbackCompleted) { return; }
+            _callbackCompleted = true;
+            _library = [library retain];
+            finishLocked();
+        }
+        _changed.notify_all();
+    }
+
+    void apiReturned(bool exception = false) {
+        {
+            std::lock_guard<std::mutex> lock(_lock);
+            _apiReturned = true;
+            if (exception) {
+                _exception = true;
+                _status.store(Status::Failed, std::memory_order_release);
+            }
+            finishLocked();
+        }
+        _changed.notify_all();
+    }
+
+    const std::shared_ptr<detail::Inputs>& inputs() const { return _inputs; }
+
+private:
+    void finishLocked() {
+        if (!_apiReturned || !_callbackCompleted || _slotReleased) { return; }
+        _slotReleased = true;
+        detail::slots().fetch_sub(1, std::memory_order_acq_rel);
+        _status.store(!_exception && _library ? Status::Success : Status::Failed, std::memory_order_release);
+    }
+
+    std::shared_ptr<detail::Inputs> _inputs;
+    std::mutex _lock;
+    std::condition_variable _changed;
+    std::atomic<Status> _status{Status::Pending};
+    bool _apiReturned = false, _callbackCompleted = false, _slotReleased = false, _exception = false;
+    id<MTLLibrary> _library = nil;
+};
+
+namespace detail {
+
+inline void executeJob(const JobPtr& job) {
+    @autoreleasepool {
+        @try {
+            const auto inputs = job->inputs();
+            // A block must capture its own shared_ptr value, not this function's
+            // const-reference parameter, which expires with the dispatch block.
+            const JobPtr ownedJob = job;
+            auto completion = ^(id<MTLLibrary> library, NSError* error) {
+                // A nonnil library with an NSError warning is still success,
+                // matching the ordinary MVKShaderLibraryCompiler path.
+                (void)error;
+                ownedJob->completed(library);
+            };
+            @synchronized (inputs->device) {
+#ifdef MVK_ENDFIELD_PREWARM_TEST
+                Submit submit = testSubmit().load(std::memory_order_acquire);
+                if (submit) { submit(inputs->device, inputs->source, inputs->options, completion); }
+                else
+#endif
+                {
+                    [inputs->device newLibraryWithSource:inputs->source options:inputs->options completionHandler:completion];
+                }
+            }
+            job->apiReturned();
+        } @catch (NSException* exception) {
+            (void)exception;
+            // An API exception does not prove no callback was enqueued. Expose
+            // local failure, but keep the slot occupied until a callback arrives.
+            // If none ever arrives, conservatively lose that speculative slot.
+            job->apiReturned(true);
+        }
+    }
+}
+
+} // namespace detail
+
+inline unsigned inflight() { return detail::slots().load(std::memory_order_acquire); }
+
+inline JobPtr start(id<MTLDevice> device, NSString* source, MTLCompileOptions* options) {
+    if (!device || !source || !detail::pinCode()) { return {}; }
+    detail::Reservation reservation;
+    if (!reservation.active) { return {}; }
+    @try {
+        try {
+            auto inputs = std::make_shared<detail::Inputs>();
+            inputs->device = [device retain];
+            inputs->source = [source copy];
+            inputs->options = [options copy];
+            if (!inputs->source || (options && !inputs->options)) { return {}; }
+            auto job = std::make_shared<Job>(inputs);
+            // Every asynchronous closure owns the job, which owns all inputs.
+            // dispatch_async has no recoverable submission-failure return value.
+            reservation.active = false;
+            dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+                detail::executeJob(job);
+            });
+            return job;
+        } catch (...) {
+            return {};
+        }
+    } @catch (NSException* exception) {
+        (void)exception;
+        return {};
+    }
+}
+
