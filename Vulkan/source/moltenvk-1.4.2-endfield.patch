+  [label appendFormat:@"%s%s%016zx:%s", label.length > 6 ? "/" : "", name,
+                      module->getKey().codeHash, stage.pName];
+  if (directory) {
+   NSString* path = [directory stringByAppendingPathComponent:
+      [NSString stringWithFormat:@"render-%016zx.spv", module->getKey().codeHash]];
+   const auto& spv = module->getSPIRV();
+   if (!spv.empty() && ![[NSFileManager defaultManager] fileExistsAtPath:path]) {
+    NSData* data = [NSData dataWithBytes:spv.data() length:spv.size() * sizeof(uint32_t)];
+    if (![data writeToFile:path atomically:YES]) {
+     fprintf(stderr, "Endfield render diagnostic could not write %s\n", path.UTF8String);
+    }
+   }
+  }
+ }
+ plDesc.label = label;
