+  if (!module) { continue; }
+  const char* name = "unknown";
+  switch (stage.stage) {
+   case VK_SHADER_STAGE_VERTEX_BIT: name = "v"; break;
+   case VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT: name = "tc"; break;
+   case VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT: name = "te"; break;
+   case VK_SHADER_STAGE_GEOMETRY_BIT: name = "g"; break;
+   case VK_SHADER_STAGE_FRAGMENT_BIT: name = "f"; break;
