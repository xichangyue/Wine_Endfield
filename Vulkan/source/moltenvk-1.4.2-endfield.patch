+public:
+    Span() = default;
+    explicit Span(const char* phase, uint64_t shaderHash = 0, const void* cache = nullptr,
+                  const char* compilerType = nullptr, int64_t pipelineIndex = -1) {
+        begin(phase, shaderHash, cache, compilerType, pipelineIndex);
+    }
+    void begin(const char* phase, uint64_t shaderHash = 0, const void* cache = nullptr,
+               const char* compilerType = nullptr, int64_t pipelineIndex = -1) {
+        if (!enabled()) { return; }
+        _phase = phase;
+        _shaderHash = shaderHash ? shaderHash : context().shaderHash;
+        _cache = cache;
+        _compilerType = compilerType;
+        _pipelineIndex = pipelineIndex;
+        _parentID = context().parentID;
+        _eventID = sink().nextID.fetch_add(1, std::memory_order_relaxed);
+        pthread_threadid_np(nullptr, &_threadID);
+        _pid = getpid();
+        _startNS = nowNS();
+        context().parentID = _eventID;
+    }
+    // May be called before releasing a timed lock. The destructor appends later,
+    // so the cache-wait measurement does not add a write while holding that lock.
+    void stop() {
+        if (!_phase || _endNS) { return; }
+        _endNS = nowNS();
+        context().parentID = _parentID;
+    }
+    ~Span() {
+        if (!_phase) { return; }
+        stop();
+        char line[1024];
+        int n = std::snprintf(line, sizeof(line),
+            "{\"phase\":\"%s\",\"start_ns\":%llu,\"end_ns\":%llu,\"pid\":%d,\"tid\":%llu,\"event_id\":%llu,\"parent_id\":%llu",
+            _phase, (unsigned long long)_startNS, (unsigned long long)_endNS, _pid,
+            (unsigned long long)_threadID, (unsigned long long)_eventID, (unsigned long long)_parentID);
+        if (_shaderHash) { n += std::snprintf(line+n, sizeof(line)-n, ",\"shader_hash\":\"%016llx\"", (unsigned long long)_shaderHash); }
+        if (_cache) { n += std::snprintf(line+n, sizeof(line)-n, ",\"cache\":\"0x%llx\"", (unsigned long long)(uintptr_t)_cache); }
+        if (_pipelineIndex >= 0) { n += std::snprintf(line+n, sizeof(line)-n, ",\"pipeline_index\":%lld", (long long)_pipelineIndex); }
+        if (_compilerType) {
+            char escaped[192]; escapeJSON(_compilerType, escaped, sizeof(escaped));
+            n += std::snprintf(line+n, sizeof(line)-n, ",\"compiler_type\":\"%s\"", escaped);
+        }
+        n += std::snprintf(line+n, sizeof(line)-n, "}\n");
+        if (n <= 0 || n >= static_cast<int>(sizeof(line))) { return; }
+        Sink& output = sink();
+        std::lock_guard<std::mutex> lock(output.writeLock);
+        ssize_t written;
+        do { written = ::write(output.fd, line, static_cast<size_t>(n)); } while (written < 0 && errno == EINTR);
+        if (written != n && !output.reportedWriteError) {
+            output.reportedWriteError = true;
+            std::fprintf(stderr, "Endfield compile timing append incomplete; diagnostic data may be truncated.\n");
+        }
+    }
+    Span(const Span&) = delete;
+    Span& operator=(const Span&) = delete;
+private:
+    const char* _phase = nullptr;
+    const char* _compilerType = nullptr;
+    const void* _cache = nullptr;
+    uint64_t _shaderHash = 0, _startNS = 0, _endNS = 0, _eventID = 0, _parentID = 0, _threadID = 0;
+    int64_t _pipelineIndex = -1;
+    int _pid = 0;
+};
+
+} // namespace mvk_endfield_timing
