+
+struct Sink {
+    int fd = -1;
+    bool reportedWriteError = false;
+    std::mutex writeLock;
+    std::atomic<uint64_t> nextID{1};
+    Sink() {
+        const char* enabled = std::getenv("ENDFIELD_COMPILE_TIMING");
+        if (!enabled || std::strcmp(enabled, "1") != 0) { return; }
+        const char* path = std::getenv("ENDFIELD_COMPILE_TIMING_PATH");
+        if (!path || !*path) {
+            std::fprintf(stderr, "Endfield compile timing disabled: ENDFIELD_COMPILE_TIMING_PATH is missing.\n");
+            return;
+        }
+        fd = ::open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+        if (fd < 0) {
+            std::fprintf(stderr, "Endfield compile timing disabled: cannot append timing file (errno=%d).\n", errno);
+        }
+    }
+    ~Sink() { if (fd >= 0) { ::close(fd); } }
+};
+
+inline Sink& sink() { static Sink value; return value; }
+inline bool enabled() { return sink().fd >= 0; }
+// On Darwin libc++, steady_clock uses mach_absolute_time: compare external
+// phase markers with CLOCK_MONOTONIC_RAW, not Python 3.9 process-relative monotonic.
+inline uint64_t nowNS() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+struct ThreadContext { uint64_t parentID = 0; uint64_t shaderHash = 0; };
+inline ThreadContext& context() { static thread_local ThreadContext value; return value; }
+
+// This context is a known currently executing shader-module lookup, not an
+// inference from a pipeline's final stage. It never invents a hash for a PSO.
+class ShaderContext {
+public:
+    explicit ShaderContext(uint64_t hash) : _enabled(enabled()) {
+        if (_enabled) { _previous = context().shaderHash; context().shaderHash = hash; }
+    }
+    ~ShaderContext() { if (_enabled) { context().shaderHash = _previous; } }
+    ShaderContext(const ShaderContext&) = delete;
+private:
+    bool _enabled;
+    uint64_t _previous = 0;
+};
+
+inline void escapeJSON(const char* input, char* output, size_t capacity) {
+    size_t n = 0;
+    if (!input) { input = ""; }
+    for (; *input && n + 2 < capacity; ++input) {
+        unsigned char c = static_cast<unsigned char>(*input);
+        if (c == '"' || c == '\\') { output[n++] = '\\'; output[n++] = c; }
+        else if (c >= 0x20) { output[n++] = c; }
+        else { output[n++] = ' '; }
+    }
+    output[n] = 0;
+}
