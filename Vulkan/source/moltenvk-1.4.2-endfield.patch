+// Inspect the same packed CPU/GPU descriptors used by the Metal3 binding path.
+// This is a host encoding-time snapshot, not proof of what the GPU later reads.
+static mvk_endfield_ubo::Snapshot snapshotEndfieldTargetUBO(
+  MVKCommandEncoder& mvkEncoder,
+  const MVKVulkanGraphicsCommandEncoderState& vk,
+  bool argumentBufferIsBound,
+  const MVKStageResourceBindings::Buffer& boundArgumentBuffer) {
+
+	using namespace mvk_endfield_ubo;
+	Snapshot result;
+	result.timestampNS = nowNS();
+	pthread_threadid_np(nullptr, &result.threadID);
+	if (!vk._layout || vk._layout->getDescriptorSetCount() <= 3 || !vk._descriptorSets[3]) { return result; }
+	MVKDescriptorSet* set = vk._descriptorSets[3];
+	const MVKDescriptorSetLayout* layout = vk._layout->getDescriptorSetLayout(3);
+	result.descriptorSet = reinterpret_cast<uintptr_t>(set);
+	result.argumentBuffer = reinterpret_cast<uintptr_t>(set->gpuBufferObject);
+	result.argumentBufferOffset = set->gpuBufferOffset;
+	if (argumentBufferIsBound) {
+		result.boundArgumentBuffer = reinterpret_cast<uintptr_t>(boundArgumentBuffer.buffer);
+		result.boundArgumentBufferOffset = boundArgumentBuffer.offset;
+		result.slotMatches = boundArgumentBuffer.buffer == set->gpuBufferObject && boundArgumentBuffer.offset == set->gpuBufferOffset;
+	}
+	if (layout->argBufMode() != MVKArgumentBufferMode::Metal3) {
+		result.status = Status::UnsupportedMode;
+		return result;
+	}
+	uint32_t bindingIndex = layout->getBindingIndex(2);
+	if (bindingIndex >= layout->bindings().size()) {
+		result.status = Status::MissingBinding;
+		return result;
+	}
+	const MVKDescriptorBinding& binding = layout->bindings()[bindingIndex];
+	result.descriptorType = binding.descriptorType;
+	result.descriptorFlags = binding.flags;
+	result.cpuLayout = static_cast<int32_t>(binding.cpuLayout);
+	result.gpuLayout = static_cast<int32_t>(binding.gpuLayout);
+	if (binding.descriptorType == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK) {
+		result.status = Status::UnsupportedInline;
+		return result;
+	}
+	bool dynamic = binding.descriptorType == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC;
+	if (!dynamic && binding.descriptorType != VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER) {
+		result.status = Status::UnsupportedType;
+		return result;
+	}
+	if (binding.cpuLayout != MVKDescriptorCPULayout::OneID2Meta ||
+		binding.gpuLayout != MVKDescriptorGPULayout::BufferAuxSize ||
+		!binding.getDescriptorCount(set->variableDescriptorCount) ||
+		!(binding.stageFlags & VK_SHADER_STAGE_FRAGMENT_BIT)) {
+		result.status = Status::InvalidLayout;
+		return result;
+	}
+	auto fits = [](uint64_t offset, uint64_t bytes, uint64_t size) {
+		return offset <= size && bytes <= size - offset;
+	};
+	if (!set->cpuBuffer || !set->gpuBuffer || !set->gpuBufferObject || !set->auxIndices ||
+		!fits(binding.cpuOffset, sizeof(MVKCPUDescriptorOneID2Meta), set->cpuBufferSize) ||
+		!fits(binding.gpuOffset, sizeof(uint64_t), set->gpuBufferSize) ||
+		binding.auxIndex >= layout->numAuxOffsets()) {
+		result.status = Status::InvalidBounds;
+		return result;
+	}
+	uint32_t sizeOffset = set->auxIndices[binding.auxIndex];
+	if (!fits(sizeOffset, sizeof(uint32_t), set->gpuBufferSize)) {
+		result.status = Status::InvalidBounds;
+		return result;
+	}
+	// Pool argument buffers are not in MVKLiveList. Their validity here follows
+	// the same statically-used descriptor lifetime as the existing bind code.
+	// Do not misclassify an unregistered pool buffer as a dead resource.
