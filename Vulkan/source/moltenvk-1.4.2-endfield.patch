+                  [this](uint32_t a, uint32_t b) { return _ring[a].snapshotID < _ring[b].snapshotID; });
+        append("{\"type\":\"export_begin\",\"pid\":%d,\"reason\":\"%s\",\"export_ns\":%llu,"
+               "\"freeze_ns\":%llu,\"freeze_scope\":\"this_collector_only_sequential_with_ubo\",\"fault_command_buffer_id\":%llu,\"fault_command_buffer\":\"0x%llx\",\"metal_error_code\":%lld,"
+               "\"fault_command_buffer_snapshots\":%llu,\"fault_command_buffer_dropped_snapshots\":%llu,"
+               "\"total_snapshots\":%llu,\"retained_snapshots\":%llu,\"overwritten_snapshots\":%llu,\"dropped_snapshots\":%llu,"
+               "\"first_retained_snapshot_id\":%llu,\"last_snapshot_id\":%llu}\n",
+               _pid, reason, (unsigned long long)nowNS(), (unsigned long long)freezeNS, (unsigned long long)faultID,
+               (unsigned long long)_faultPointer, (long long)errorCode,
+               (unsigned long long)faultSnapshots, (unsigned long long)faultDropped,
+               (unsigned long long)total, (unsigned long long)retained, (unsigned long long)overwritten, (unsigned long long)dropped,
+               (unsigned long long)(retained ? _ring[_exportOrder[0]].snapshotID : 0), (unsigned long long)total);
