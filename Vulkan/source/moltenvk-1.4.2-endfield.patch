+        // Formatting/I/O occurs with no resource-live or ring lock held.
+        size_t orderCount = 0;
+        uint64_t faultSnapshots = 0;
+        for (size_t i = 0; i < Capacity; ++i) {
+            if (_ring[i].snapshotID) {
+                _exportOrder[orderCount++] = static_cast<uint32_t>(i);
