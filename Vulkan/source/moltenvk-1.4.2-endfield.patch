+			result.status = Status::PrivateStorage;
+			return result;
+		}
+		if (buffer.storageMode != MTLStorageModeShared && buffer.storageMode != MTLStorageModeManaged) {
+			result.status = Status::NoContents;
+			return result;
+		}
+		const char* contents = static_cast<const char*>(buffer.contents);
+		if (!contents) {
+			result.status = Status::NoContents;
+			return result;
+		}
+		memcpy(&result.nBits, contents + result.effectiveOffset + 40, sizeof(result.nBits));
+		result.nReadable = true;
+		result.status = buffer.storageMode == MTLStorageModeManaged ? Status::ManagedCPUCopy : Status::Ok;
+	}
+	return result;
