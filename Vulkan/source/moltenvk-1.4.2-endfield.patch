+        append("{\"type\":\"meta\",\"version\":1,\"pid\":%d,\"capacity\":%zu,\"started_ns\":%llu,"
+               "\"clock\":\"CLOCK_MONOTONIC_RAW\",\"scope\":\"cpu_encode_resource_snapshot\","
+               "\"target_vertex_hash\":\"a4a855eec0437744\",\"target_fragment_hash\":\"f50e58483a8e93fe\","
